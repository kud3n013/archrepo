# Maintainer: archrepo CI <ci@archrepo>
# Upstream: https://github.com/CosmoCreeper/Sine

_pkgname=sine
pkgname=sine
pkgver=2.3.3
pkgrel=1
pkgdesc="The ultimate mod and theme manager for Firefox-based browsers"
arch=('x86_64')
url="https://github.com/CosmoCreeper/Sine"
license=('MPL-2.0')
provides=('sine-bin')
conflicts=('sine-bin')
replaces=('sine-bin')
backup=('etc/sine-flags.conf')
install=sine.install
depends=(
    'curl'
    'glibc'
    'hicolor-icon-theme'
    'libglvnd'
    'libx11'
    'libxcursor'
    'libxi'
    'libxinerama'
    'libxrandr'
    'libxxf86vm'
    'unzip'
)
optdepends=(
    'libxkbcommon: Wayland keyboard handling'
    'polkit: Administrator privilege elevation (pkexec) for system-wide browser installations'
    'wayland: Wayland display protocol support'
)
options=(!strip !debug)
source=(
    "${_pkgname}-${pkgver}-x86_64::https://github.com/CosmoCreeper/Sine/releases/download/v${pkgver}/sine-linux-x64"
    "LICENSE-${pkgver}::https://raw.githubusercontent.com/CosmoCreeper/Sine/v${pkgver}/LICENSE"
    "${_pkgname}.sh"
    "${_pkgname}-flags.conf"
    "${_pkgname}.desktop"
    "${_pkgname}.png"
)
sha256sums=('b4d3af1eaf744adbfdbd7e0cc931fd73ce7a21a21a8f6874b6fd4f533ccd6d5b'
            '3972dc9744f6499f0f9b2dbf76696f2ae7ad8af9b23dde66d6af86c9dfb36986'
            'cf0f23d935d9566543e9a3ad90d834254b3dd611bfadf86faa444709065ba87b'
            '414d0ede1b31d5f44a961b093a86b277221aaf2598d05691c710beab21f6b361'
            '7ab5aeeb048c7f4b3bb439f6ee7345ee28cf524fe2034a4fd6555e8489ee2316'
            '34be82334a44583b233739def8793aeb7d543757f6bb0b94280af0a8e8de2c0f')

prepare() {
    chmod +x "${srcdir}/${_pkgname}-${pkgver}-x86_64"
}

package() {
    # Install application binary into /opt/sine
    install -dm755 "${pkgdir}/opt/${_pkgname}"
    install -Dm755 "${srcdir}/${_pkgname}-${pkgver}-x86_64" "${pkgdir}/opt/${_pkgname}/${_pkgname}"

    # Install launcher wrapper script
    install -Dm755 "${srcdir}/${_pkgname}.sh" "${pkgdir}/usr/bin/${_pkgname}"

    # Install system-wide default flags configuration
    install -Dm644 "${srcdir}/${_pkgname}-flags.conf" "${pkgdir}/etc/${_pkgname}-flags.conf"

    # Install FreeDesktop desktop entry
    install -Dm644 "${srcdir}/${_pkgname}.desktop" "${pkgdir}/usr/share/applications/${_pkgname}.desktop"

    # Install application icons
    install -Dm644 "${srcdir}/${_pkgname}.png" "${pkgdir}/usr/share/icons/hicolor/512x512/apps/${_pkgname}.png"
    install -Dm644 "${srcdir}/${_pkgname}.png" "${pkgdir}/usr/share/pixmaps/${_pkgname}.png"

    # Install license
    install -Dm644 "${srcdir}/LICENSE-${pkgver}" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"

    # Fix overall permissions
    chmod -R u+rwX,go+rX,go-w "${pkgdir}"
}
