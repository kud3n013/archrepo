# Maintainer: archrepo CI <ci@archrepo>
pkgname=fastfetch
pkgver=2.40.3
pkgrel=1
pkgdesc="Like neofetch, but much faster because written mostly in C"
arch=('x86_64')
url="https://github.com/fastfetch-cli/fastfetch"
license=('MIT')
depends=('glibc')
makedepends=('cmake' 'vulkan-headers' 'vulkan-icd-loader' 'wayland'
             'libxcb' 'libxrandr' 'libx11' 'libdrm' 'dconf'
             'dbus' 'imagemagick' 'chafa' 'zlib' 'hwdata'
             'opencl-headers' 'ocl-icd' 'libnm' 'libpulse'
             'ddcutil' 'directx-headers' 'libelf')
options=(!debug)
source=("${pkgname}-${pkgver}.tar.gz::https://github.com/fastfetch-cli/fastfetch/archive/refs/tags/${pkgver}.tar.gz")
sha256sums=('SKIP')

build() {
  cd "${pkgname}-${pkgver}"
  cmake -B build \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_BUILD_TYPE=Release \
    -DBUILD_TESTS=OFF
  cmake --build build --target fastfetch --target flashfetch
}

package() {
  cd "${pkgname}-${pkgver}"
  DESTDIR="${pkgdir}" cmake --install build
  install -Dm644 LICENSE -t "${pkgdir}/usr/share/licenses/${pkgname}"
}
