_pkgname=proton-pass
pkgname=proton-pass
pkgver=1.40.2
pkgrel=1
pkgdesc="Official desktop application for Proton Pass: end-to-end encrypted password and identity manager"
arch=('x86_64')
url="https://proton.me/pass"
license=('GPL-3.0-or-later')
provides=('protonpass' "${pkgname}-bin")
conflicts=('protonpass' "${pkgname}-bin")
replaces=("${pkgname}-bin")
install=proton-pass.install
backup=("etc/${_pkgname}-flags.conf")
options=(!strip !debug)

depends=(
    'alsa-lib'
    'at-spi2-core'
    'cairo'
    'dbus'
    'expat'
    'glib2'
    'glibc'
    'gtk3'
    'hicolor-icon-theme'
    'libcups'
    'libgcc'
    'libx11'
    'libxcb'
    'libxcomposite'
    'libxdamage'
    'libxext'
    'libxfixes'
    'libxkbcommon'
    'libxrandr'
    'libxss'
    'libxtst'
    'mesa'
    'nspr'
    'nss'
    'pango'
)

source=(
    "${pkgname}-${pkgver}.deb::https://proton.me/download/pass/linux/proton-pass_${pkgver}_amd64.deb"
    "${_pkgname}.sh"
    "${_pkgname}-flags.conf"
    "${_pkgname}.desktop"
    "${_pkgname}.png"
)
sha512sums=('c9bd58a7266dc78fd33da6b7c127930424e47277c9db8a521b079c68557e33e510f02fb8c3db26190f31ae3a14bb3951bf498a41b73a3fdd021376e24653a78a'
            'e6d115db69fd5287d492651807017802ae63955a216226c53e4390af07419f282e2914d1f6862140ac1b5460d390c64134ac4a6eba8338f9648bcef9bfe05bd6'
            '017ca5f2509669efd33a8520a27c784e237a5300b0a37fb69c26076df4e2b167be848eda9ac3214d9d22dbd82cc4706763226b89f280103c52341a72411e3803'
            '1621bc714d50a27ec4ab30eed1b08e2ac8aa8434128c2d07ac0681ba475f0572808e91069382547dfef791ee1ed5444111657b45e14ed03703253b53ac84ec51'
            '77c5df969f38a47fb586ee17e44510eb7a981c94fc6406588fd013600af0a3c4891ad06484582ff9ac23ede8e7a7f1ef9ac5188fb371c1fc9c98470daffd48cd')

prepare() {
    # Extract deb archive data payload
    tar -xf data.tar.xz
}

package() {
    # Install application files into /opt/proton-pass
    install -dm755 "${pkgdir}/opt"
    cp -a "usr/lib/${_pkgname}" "${pkgdir}/opt/${_pkgname}"

    # Fix binary permissions
    chmod 755 "${pkgdir}/opt/${_pkgname}/Proton Pass"
    chmod -R o-w "${pkgdir}/opt/${_pkgname}/resources/assets" 2>/dev/null || true

    # Provide convenient unspaced symlink inside /opt/proton-pass
    ln -sf "Proton Pass" "${pkgdir}/opt/${_pkgname}/${_pkgname}"

    # Install launcher wrapper script
    install -Dm755 "${srcdir}/${_pkgname}.sh" "${pkgdir}/usr/bin/${_pkgname}"

    # Install system-wide flags configuration
    install -Dm644 "${srcdir}/${_pkgname}-flags.conf" "${pkgdir}/etc/${_pkgname}-flags.conf"

    # Install desktop entry
    install -Dm644 "${srcdir}/${_pkgname}.desktop" "${pkgdir}/usr/share/applications/${_pkgname}.desktop"

    # Install high-resolution application icons
    install -Dm644 "${srcdir}/${_pkgname}.png" "${pkgdir}/usr/share/icons/hicolor/512x512/apps/${_pkgname}.png"
    install -Dm644 "${srcdir}/${_pkgname}.png" "${pkgdir}/usr/share/pixmaps/${_pkgname}.png"
    if [ -f "usr/share/pixmaps/${_pkgname}.png" ]; then
        # Upstream deb distributes scalable SVG under this path
        install -Dm644 "usr/share/pixmaps/${_pkgname}.png" "${pkgdir}/usr/share/icons/hicolor/scalable/apps/${_pkgname}.svg"
    fi

    # Install licenses
    if [ -f "${pkgdir}/opt/${_pkgname}/LICENSES.chromium.html" ]; then
        install -Dm644 "${pkgdir}/opt/${_pkgname}/LICENSES.chromium.html" -t "${pkgdir}/usr/share/licenses/${pkgname}/"
    fi
    if [ -f "usr/share/doc/${_pkgname}/copyright" ]; then
        install -Dm644 "usr/share/doc/${_pkgname}/copyright" "${pkgdir}/usr/share/licenses/${pkgname}/copyright"
    fi

    # Fix directory and file permissions
    chmod -R u+rwX,go+rX,go-w "${pkgdir}"
    if [ -f "${pkgdir}/opt/${_pkgname}/chrome-sandbox" ]; then
        chmod 4755 "${pkgdir}/opt/${_pkgname}/chrome-sandbox"
    fi
}
