# Contributor: AlphaLynx <alphalynx at alphalynx dot dev>
# Contributor: Nguyễn Quang Minh <minhnbnt at gmail dot com>

_pkgname=proton-pass-cli
pkgname=proton-pass-cli
pkgver=2.3.3
pkgrel=3
pkgdesc="A command-line interface for managing your Proton Pass vaults, items, and secrets"
arch=('x86_64')
url="https://protonpass.github.io/pass-cli"
license=('GPL-3.0-or-later')
depends=('glibc' 'libgcc')
optdepends=(
    'org.freedesktop.secrets: for persistent session credentials across reboots (e.g. gnome-keyring, keepassxc)'
    'xdg-utils: for web-based browser login integration'
)
provides=(
    "protonpass-cli=${pkgver}"
    "proton-pass-cli-bin=${pkgver}"
    "pass-cli=${pkgver}"
)
conflicts=(
    'protonpass-cli'
    'proton-pass-cli-bin'
    'pass-cli'
)
replaces=('proton-pass-cli-bin')
backup=('etc/proton-pass-cli.conf')
options=(!strip !debug)

_downloadUrl="https://github.com/protonpass/pass-cli/releases/download/${pkgver}"
source=(
    "pass-cli-${pkgver}::${_downloadUrl}/pass-cli-linux-x86_64"
    "LICENSE-${pkgver}::https://raw.githubusercontent.com/protonpass/pass-cli/${pkgver}/LICENSE"
    "proton-pass-cli.sh"
    "proton-pass-cli.conf"
)
sha256sums=('b5b49a8b3fd0af8830c0c1979f28ea0c90ccece73f59023a8bca8245d4b68da9'
            'c7900f97f653a7f70ff78acd49d25078807c60eec1cc860df23b9f44043977ba'
            '49a8dbd624b82a20cfd4b128a40db6f565048503e78b676aeb01ee4dc9b94e16'
            '03eeb8a893acaf215d909595b354fb823195223edd4702cc1a0807f1a40a7d1e')

package() {
    # Install upstream CLI executable to private lib directory
    install -Dm755 "${srcdir}/pass-cli-${pkgver}" "${pkgdir}/usr/lib/${pkgname}/pass-cli"

    # Install launcher wrapper script (handles keyring persistence across reboots)
    install -Dm755 "${srcdir}/proton-pass-cli.sh" "${pkgdir}/usr/bin/pass-cli"

    # Convenience alias symlink
    ln -sr "${pkgdir}/usr/bin/pass-cli" "${pkgdir}/usr/bin/proton-pass-cli"

    # Install configuration template
    install -Dm644 "${srcdir}/proton-pass-cli.conf" "${pkgdir}/etc/proton-pass-cli.conf"

    # Shell completions (NTFS-safe execution via /tmp)
    local _bin="/tmp/pass-cli-${pkgver}-$$-exec"
    cp -f "${srcdir}/pass-cli-${pkgver}" "${_bin}"
    chmod 755 "${_bin}"
    if "${_bin}" --version &>/dev/null; then
        "${_bin}" completions bash > pass-cli.bash
        "${_bin}" completions zsh > _pass-cli
        "${_bin}" completions fish > pass-cli.fish

        install -Dm644 pass-cli.bash "${pkgdir}/usr/share/bash-completion/completions/pass-cli"
        install -Dm644 _pass-cli "${pkgdir}/usr/share/zsh/site-functions/_pass-cli"
        install -Dm644 pass-cli.fish "${pkgdir}/usr/share/fish/vendor_completions.d/pass-cli.fish"

        # Alias completions
        ln -sr "${pkgdir}/usr/share/bash-completion/completions/pass-cli" "${pkgdir}/usr/share/bash-completion/completions/proton-pass-cli"
        ln -sr "${pkgdir}/usr/share/zsh/site-functions/_pass-cli" "${pkgdir}/usr/share/zsh/site-functions/_proton-pass-cli"
        ln -sr "${pkgdir}/usr/share/fish/vendor_completions.d/pass-cli.fish" "${pkgdir}/usr/share/fish/vendor_completions.d/proton-pass-cli.fish"
    fi
    rm -f "${_bin}"

    # Upstream license
    install -Dm644 "${srcdir}/LICENSE-${pkgver}" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"

    # Ensure clean permissions
    chmod -R u+rwX,go+rX,go-w "${pkgdir}"
}
