# Maintainer: archrepo CI <ci@archrepo>
# Upstream: https://github.com/zen-browser/desktop
# AUR Reference: https://aur.archlinux.org/packages/zen-browser-bin

_pkgname=zen-browser
pkgname=zen-browser
pkgver=1.22.2b
pkgrel=1
pkgdesc="Zen Browser — a privacy-focused, feature-packed Firefox-based web browser"
arch=('x86_64')
url="https://github.com/zen-browser/desktop"
license=('MPL-2.0')
provides=('zen-browser-bin')
conflicts=('zen-browser-bin')
replaces=('zen-browser-bin')
install=zen-browser.install
backup=('etc/zen-browser-flags.conf')
depends=(
    'gtk3'
    'libxt'
    'mime-types'
    'nss'
    'ttf-font'
    'systemd'
    'ffmpeg'
)
optdepends=(
    'networkmanager: Location detection via available WiFi networks'
    'libnotify: Notification integration'
    'pulse-native-provider: Audio support'
    'speech-dispatcher: Text-to-Speech'
    'hunspell-en_US: Spell checking, American English'
    'xdg-desktop-portal: Screen sharing and file dialogs on Wayland'
    'pipewire: Screen sharing support on Wayland compositors'
    'wl-clipboard: Clipboard support on Wayland'
    'ffmpeg4.4: Legacy codec support for Twitch and YouTube live streams'
)
options=(!strip !debug)
source=(
    "zen-browser-${pkgver}.tar.xz::https://github.com/zen-browser/desktop/releases/download/${pkgver}/zen.linux-x86_64.tar.xz"
    "zen-browser.sh"
    "zen-browser-flags.conf"
    "zen-browser.desktop"
    "zen-browser.install"
    "policies.json"
)
sha256sums=('163823cf56b068e81bb8a48d93c9dbda3993f54f03f8d37e684e380bfc11b892'
            '0234c2ed7fa451905beedd96c277b28263495a945d6c337b048a14b81d949290'
            'e1e70b93f4707525d517746933b668f9faabd72e2dac7640324a2e106df10769'
            '43d1850a9985cca030b4ba6778a54d4698de3efde9dbdd58e27ab4eb0dc59113'
            'f566bbe8360ed280385dbc83f57177cc9b78cbde5a6e8cfb89cfa80890b0c9d5'
            'fd9572d178ea1a5edf427ca85bad3fb2d83be2e250e62bad13951d70d977bd0f')

package() {
    # Create directories
    install -dm755 "${pkgdir}/usr/bin"
    install -dm755 "${pkgdir}/usr/share/applications"

    # Install application files to /opt/zen-browser (contents of zen/ directly)
    install -dm755 "${pkgdir}/opt"
    cp -r zen "${pkgdir}/opt/${_pkgname}"

    # Install launcher wrapper script
    install -Dm755 "${srcdir}/${_pkgname}.sh" "${pkgdir}/usr/bin/${_pkgname}"

    # Install system-wide default flags file
    install -Dm644 "${srcdir}/${_pkgname}-flags.conf" "${pkgdir}/etc/${_pkgname}-flags.conf"

    # Install desktop entry
    install -Dm644 "${srcdir}/${_pkgname}.desktop" "${pkgdir}/usr/share/applications/${_pkgname}.desktop"

    # Install icons — symlink from upstream's bundled icon set
    for i in 16x16 32x32 48x48 64x64 128x128; do
        install -dm755 "${pkgdir}/usr/share/icons/hicolor/${i}/apps"
        ln -s "/opt/${_pkgname}/browser/chrome/icons/default/default${i/x*/}.png" \
              "${pkgdir}/usr/share/icons/hicolor/${i}/apps/${_pkgname}.png"
    done
    install -dm755 "${pkgdir}/usr/share/pixmaps"
    ln -s "/opt/${_pkgname}/browser/chrome/icons/default/default128.png" \
          "${pkgdir}/usr/share/pixmaps/${_pkgname}.png"

    # Use system-provided dictionaries
    ln -Ts /usr/share/hunspell "${pkgdir}/opt/${_pkgname}/dictionaries"
    ln -Ts /usr/share/hyphen "${pkgdir}/opt/${_pkgname}/hyphenation"

    # Use system certificates
    ln -sf /usr/lib/libnssckbi.so "${pkgdir}/opt/${_pkgname}/libnssckbi.so"

    # Disable update checks (managed by pacman)
    install -dm755 "${pkgdir}/opt/${_pkgname}/distribution"
    install -Dm644 "${srcdir}/policies.json" "${pkgdir}/opt/${_pkgname}/distribution/policies.json"

    # Fix overall permissions
    chmod -R u+rwX,go+rX,go-w "${pkgdir}"
}
