_cleanup_user_desktops() {
    # Remove rogue or duplicate user-level desktop files left behind by older versions or desktop integration
    for user_home in /home/*; do
        if [ -d "$user_home/.local/share/applications" ]; then
            rm -f "$user_home/.local/share/applications/gdlauncher-carbon.desktop" \
                  "$user_home/.local/share/applications/GDLauncher Carbon.desktop" \
                  "$user_home/.local/share/applications/GDLauncher-Carbon.desktop" 2>/dev/null || true
        fi
        if [ -d "$user_home/.local/share/icons" ]; then
            rm -f "$user_home/.local/share/icons/gdlauncher-carbon.png" \
                  "$user_home/.local/share/icons/gdlauncher_carbon.png" 2>/dev/null || true
        fi
    done
    update-desktop-database -q 2>/dev/null || true
}

post_install() {
    _cleanup_user_desktops
}

post_upgrade() {
    _cleanup_user_desktops
}

post_remove() {
    _cleanup_user_desktops
}
