# Maintainer: kud3n013 <kud3n.013@proton.me>
# Upstream: https://github.com/kud3n013/kast

pkgname=kast
pkgver=0.7.2
pkgrel=1
pkgdesc="Kud3n's Arch Setup Tool: Arch/CachyOS setup TUI with App Vault backups to Proton Drive"
arch=('x86_64')
url="https://github.com/kud3n013/kast"
license=('GPL-3.0-or-later')
# The binary is static (musl) so it needs no libraries, but the TUI and every
# setup command re-run themselves through sudo to get root.
depends=('sudo')
optdepends=('proton-drive-cli: Proton Drive backups'
            'snapper: btrfs snapshots before upgrades'
            'curl: refresh packages.toml online (a built-in list is used otherwise)')
# AUR kast-bin is an unrelated video-casting tool that also provides "kast".
conflicts=('kast-bin')
options=(!strip !debug !lto)
source=("kast-${pkgver}::https://github.com/kud3n013/kast/releases/download/v${pkgver}/kast-${CARCH}-unknown-linux-musl"
        "LICENSE-${pkgver}::https://raw.githubusercontent.com/kud3n013/kast/v${pkgver}/LICENSE")
sha256sums=('300b4b666f32f03c5d7a8a8af8dbcf63105b9a2466bc165a91c7d309af174cbd'
            '3972dc9744f6499f0f9b2dbf76696f2ae7ad8af9b23dde66d6af86c9dfb36986')

package() {
    install -Dm755 "${srcdir}/kast-${pkgver}" "${pkgdir}/usr/bin/kast"
    install -Dm644 "${srcdir}/LICENSE-${pkgver}" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"

    chmod -R u+rwX,go+rX,go-w "${pkgdir}"
}
