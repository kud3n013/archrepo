_cleanup_user_desktops() {
    # The app's "Create desktop entry" action writes a user-level copy that
    # points at its own executable and shadows the packaged entry.
    for user_home in /home/*; do
        if [ -d "$user_home/.local/share/applications" ]; then
            rm -f "$user_home/.local/share/applications/com.abdownloadmanager.desktop" \
                  "$user_home/.local/share/applications/ab-download-manager.desktop" 2>/dev/null || true
        fi
    done
    update-desktop-database -q 2>/dev/null || true
}

post_install() {
    _cleanup_user_desktops
}

post_upgrade() {
    _cleanup_user_desktops
}

post_remove() {
    _cleanup_user_desktops
}
