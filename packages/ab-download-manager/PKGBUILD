# Maintainer: archrepo CI <ci@archrepo>
# Upstream: https://github.com/amir1376/ab-download-manager
# AUR Reference: https://aur.archlinux.org/packages/ab-download-manager-bin

_pkgname=ab-download-manager
_appname=ABDownloadManager
pkgname=ab-download-manager
pkgver=1.11.4
pkgrel=1
pkgdesc="Download manager with multi-connection acceleration, queues, speed limits and browser integration"
arch=('x86_64')
url="https://abdownloadmanager.com"
license=('Apache-2.0')
# The jpackage bundle carries its own JetBrains Runtime 25, so no java-runtime
depends=(
    'alsa-lib'
    'fontconfig'
    'freetype2'
    'glibc'
    'hicolor-icon-theme'
    'libglvnd'
    'libstdc++'
    'libx11'
    'libxext'
    'libxi'
    'libxrender'
    'libxtst'
    'zlib'
)
optdepends=(
    'libappindicator-gtk3: system tray icon'
    'libnotify: desktop notifications'
)
provides=("${_pkgname}-bin" 'abdownloadmanager')
conflicts=("${_pkgname}-bin" 'abdownloadmanager' 'abdownloadmanager-bin')
replaces=("${_pkgname}-bin")
install="${_pkgname}.install"
backup=("etc/${_pkgname}-flags.conf")
options=(!strip !debug)
source=(
    "${_appname}_${pkgver}_linux_x64.tar.gz::https://github.com/amir1376/ab-download-manager/releases/download/v${pkgver}/${_appname}_${pkgver}_linux_x64.tar.gz"
    "${_pkgname}.sh"
    "${_pkgname}-flags.conf"
    "com.abdownloadmanager.desktop"
)
sha256sums=('33c4b33472518c1f0b829c388ef114f8363805493b8c67e1e78688f580efa741'
            '0da5780d19eba97cf5c3163f82a259a5adb351c7d01ad3a9fd53c93213829868'
            'c435dc7b010e4fa066b3cbb97cbca1ca4d9334b2f894edb18e2fed8849dd9f84'
            '2e0219dcd498b9593219f92644272a6d0d601e36373c9d1e89d45160e2dae612')

package() {
    # jpackage app image: bin/ launchers, lib/app jars, lib/runtime JRE.
    # Root-owned /opt also turns off the in-app updater, which only runs
    # when the installation folder is writable, so pacman handles updates.
    install -dm755 "${pkgdir}/opt/${_pkgname}"
    cp -a "${srcdir}/${_appname}/." "${pkgdir}/opt/${_pkgname}/"

    # GUI launcher (environment from the flags file) and the CLI
    install -Dm755 "${srcdir}/${_pkgname}.sh" "${pkgdir}/usr/bin/${_pkgname}"
    install -dm755 "${pkgdir}/usr/bin"
    ln -s "/opt/${_pkgname}/bin/${_appname}Cli" "${pkgdir}/usr/bin/${_pkgname}-cli"

    install -Dm644 "${srcdir}/${_pkgname}-flags.conf" "${pkgdir}/etc/${_pkgname}-flags.conf"
    install -Dm644 "${srcdir}/com.abdownloadmanager.desktop" \
        "${pkgdir}/usr/share/applications/com.abdownloadmanager.desktop"

    # 512x512 icon shipped in the bundle
    install -Dm644 "${srcdir}/${_appname}/lib/${_appname}.png" \
        "${pkgdir}/usr/share/icons/hicolor/512x512/apps/${_pkgname}.png"
    install -Dm644 "${srcdir}/${_appname}/lib/${_appname}.png" \
        "${pkgdir}/usr/share/pixmaps/${_pkgname}.png"

    chmod -R u+rwX,go+rX,go-w "${pkgdir}"
}
