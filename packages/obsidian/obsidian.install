_cleanup_user_desktops() {
    # Remove rogue or duplicate user-level desktop files left behind by older versions or desktop integration
    for user_home in /home/*; do
        if [ -d "$user_home/.local/share/applications" ]; then
            rm -f "$user_home/.local/share/applications/obsidian.desktop" \
                  "$user_home/.local/share/applications/Obsidian.desktop" \
                  "$user_home/.local/share/applications/md.obsidian.Obsidian.desktop" 2>/dev/null || true
        fi
        if [ -d "$user_home/.local/share/icons" ]; then
            rm -f "$user_home/.local/share/icons/obsidian.png" \
                  "$user_home/.local/share/icons/Obsidian.png" 2>/dev/null || true
        fi
    done
    update-desktop-database -q 2>/dev/null || true
}

post_install() {
    _cleanup_user_desktops

    if ! { [[ -L /proc/self/ns/user ]] && unshare --user true; }; then
        chmod 4755 '/opt/Obsidian/chrome-sandbox' || true
    else
        chmod 0755 '/opt/Obsidian/chrome-sandbox' || true
    fi

    if hash update-mime-database 2>/dev/null; then
        update-mime-database /usr/share/mime || true
    fi
}

post_upgrade() {
    post_install
}

post_remove() {
    _cleanup_user_desktops

    if hash update-mime-database 2>/dev/null; then
        update-mime-database /usr/share/mime || true
    fi
}
