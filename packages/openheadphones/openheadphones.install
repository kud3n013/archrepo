_cleanup_user_desktops() {
    for user_home in /home/*; do
        if [ -d "$user_home/.local/share/applications" ]; then
            rm -f "$user_home/.local/share/applications/jbl-headphones.desktop" \
                  "$user_home/.local/share/applications/openheadphones.desktop" 2>/dev/null || true
        fi
    done
    update-desktop-database -q 2>/dev/null || true
}

post_install() {
    _cleanup_user_desktops
    echo ":: BlueZ (bluetooth.service) must be running for OpenHeadphones to reach your headphones:"
    echo "   sudo systemctl enable --now bluetooth.service"
    echo ":: Updates come through pacman; the app only reports new upstream releases."
}

post_upgrade() {
    _cleanup_user_desktops
}

post_remove() {
    _cleanup_user_desktops
}
