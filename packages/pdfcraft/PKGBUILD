# Maintainer: kud3n013 <kud3n.013@proton.me>
# Upstream: https://github.com/storytold/pdfcraft
# AUR Reference: https://aur.archlinux.org/packages/pdfcraft-bin

pkgname=pdfcraft
pkgver=0.13.0
pkgrel=2
pkgdesc="PdfCraft, an open-source PDF reader and editor (Acrobat alternative) from the ArtCraft suite"
arch=('x86_64')
url="https://github.com/storytold/pdfcraft"
license=('MIT OR Apache-2.0' 'OFL-1.1')
# The binaries link only glibc and libgcc. The window system,
# GPU and D-Bus libraries are opened at run time, so they are listed here by hand.
# pdfcraft-cli ships separately, from upstream's standalone CLI tarball.
depends=('pdfcraft-cli' 'glibc' 'gcc-libs' 'hicolor-icon-theme' 'dbus' 'libxkbcommon' 'libxkbcommon-x11' 'libx11' 'libxcursor' 'libxi' 'libxrandr' 'wayland' 'libglvnd' 'vulkan-icd-loader')
optdepends=('vulkan-driver: GPU rendering through Vulkan (falls back to OpenGL or the CPU)'
            'xdg-desktop-portal: native file dialogs and the desktop light/dark setting'
            'zenity: file dialogs without a portal'
            'xdg-utils: open links in the browser')
provides=('pdfcraft-bin')
conflicts=('pdfcraft-bin' 'pdfcraft-git' 'printcraft' 'printcraft-bin' 'printcraft-git')
replaces=('pdfcraft-bin')
options=(!strip !debug)
source=("${pkgname}-${pkgver}-linux-x86_64.tar.gz::${url}/releases/download/v${pkgver}/${pkgname}-${pkgver}-linux-x86_64.tar.gz"
        "pdfcraft.sh")
sha256sums=('598519ea2bc77c66ca9a906241e1fe3eccf745f50627ce3cdbd5b5e675a456d3'
            'b29d8003aaa6778cfb57200e1a4d146b68c6cda269df38d7b6533d17db7fd37f')

package() {
    local _root="${srcdir}/${pkgname}-${pkgver}-linux-x86_64"

    # The launcher at /usr/bin/pdfcraft applies archrepo's defaults once, then runs
    # the real binary. Its share/ link keeps the app's exe-relative ../share lookups.
    install -Dm755 "${_root}/bin/${pkgname}" "${pkgdir}/usr/lib/${pkgname}/bin/${pkgname}"
    ln -s ../../share "${pkgdir}/usr/lib/${pkgname}/share"
    install -Dm755 "${srcdir}/${pkgname}.sh" "${pkgdir}/usr/bin/${pkgname}"
    cp -dr --no-preserve=ownership "${_root}/share" "${pkgdir}/usr/"

    install -dm755 "${pkgdir}/usr/share/licenses/${pkgname}"
    find "${_root}/share/doc/${pkgname}" -maxdepth 1 -type f \( -name 'LICENSE-*' -o -name 'NOTICE' -o -name 'OFL-*' \) \
        -exec install -m644 -t "${pkgdir}/usr/share/licenses/${pkgname}/" {} +

    chmod -R u+rwX,go+rX,go-w "${pkgdir}"
}
