# Maintainer: archrepo CI <ci@archrepo>
# Upstream: https://www.cursor.com

_pkgname=cursor
pkgname=cursor
pkgver=3.22.7
_commithash=37076c6c3f9e253c0fa2305197e45befd13a2268
pkgrel=2
pkgdesc="AI-first code editor built for pair programming with artificial intelligence (official binary release with KDE Global Menu integration)"
arch=('x86_64')
url="https://www.cursor.com"
license=('custom:Commercial')
provides=("${pkgname}-bin")
conflicts=("${pkgname}-bin")
replaces=("${pkgname}-bin")
backup=("etc/${pkgname}-flags.conf")
install=${pkgname}.install
options=(!strip !debug)

depends=(
    'alsa-lib'
    'at-spi2-core'
    'cairo'
    'dbus'
    'expat'
    'gcc-libs'
    'glib2'
    'glibc'
    'gtk3'
    'hicolor-icon-theme'
    'libcups'
    'libsecret'
    'libx11'
    'libxcb'
    'libxcomposite'
    'libxdamage'
    'libxext'
    'libxfixes'
    'libxkbcommon'
    'libxkbfile'
    'libxrandr'
    'libxss'
    'mesa'
    'nspr'
    'nss'
    'pango'
    'systemd-libs'
    'xdg-utils'
)

makedepends=(
    'glib2'
    'nodejs'
)

optdepends=(
    'appmenu-gtk-module: for KDE Plasma Global Menu export via XWayland'
    'bash-completion: bash shell completions'
    'zsh: zsh shell completions'
    'libdbusmenu-glib: KDE Plasma Global Menu integration'
    'org.freedesktop.secrets: Keyring/Secret Service credential management'
)

source=(
    "${pkgname}_${pkgver}_amd64.deb::https://downloads.cursor.com/production/${_commithash}/linux/x64/deb/amd64/deb/cursor_${pkgver}_amd64.deb"
    "${pkgname}.sh"
    "${pkgname}-flags.conf"
    "${pkgname}.desktop"
    "${pkgname}-url-handler.desktop"
    "${pkgname}-globalmenu.c"
    "patch-globalmenu.js"
)

noextract=("${pkgname}_${pkgver}_amd64.deb")

sha256sums=('923fd2d29cd11ceb0e230032b5649571c03c3076fd629a5d5b169b0f337800ab'
            '99e4463b667d6b580616303cb34084aad006d78dd177439d4eefe988c4cf3ab2'
            '14aa994c5a9d6bf3bad36b3e3fe5bee0cec5b50896ee6717c3f2314bf4e2ca9d'
            '1e0189f87fbe6252277e12123c23ed0760431336e012eb55dcb10289549890ec'
            '3bc1ff3dc782de1eb3b8b2d1a5e2d879fbe4447396f8dc734001474d70ec8a02'
            'e38eac6d0bca9bddede22410c7b0dbcfcaab11b42710278fff716a9d082a675c'
            '9e105794701081a392877b7514f01f22ef16e8d296cb53ceb8e65bf91f7d124e')

prepare() {
    cd "${srcdir}"
    bsdtar -xf "${pkgname}_${pkgver}_amd64.deb" data.tar.xz
    bsdtar -xf data.tar.xz

    # Patch Cursor main process to export menus to DBus/KWin and auto-hide in-window menubar
    node "${srcdir}/patch-globalmenu.js" "${srcdir}/usr/share/cursor/resources/app/out/main.js"

    # Validate JavaScript syntax
    node -c "${srcdir}/usr/share/cursor/resources/app/out/main.js"
}

build() {
    cd "${srcdir}"
    gcc -shared -fPIC -O2 "${srcdir}/${pkgname}-globalmenu.c" \
        -o "${srcdir}/lib${pkgname}-globalmenu.so" \
        $(pkg-config --cflags --libs glib-2.0) -ldl
}

package() {
    cd "${srcdir}"

    # 1. Main application files to /opt/cursor
    install -dm755 "${pkgdir}/opt/${_pkgname}"
    cp -a usr/share/cursor/. "${pkgdir}/opt/${_pkgname}/"

    # Set binary and executable permissions
    chmod 755 "${pkgdir}/opt/${_pkgname}/${_pkgname}"
    chmod 755 "${pkgdir}/opt/${_pkgname}/chrome_crashpad_handler"
    chmod 755 "${pkgdir}/opt/${_pkgname}/chrome-sandbox" 2>/dev/null || true
    chmod 755 "${pkgdir}/opt/${_pkgname}/bin/"*
    chmod 755 "${pkgdir}/opt/${_pkgname}/"*.so*

    # 2. Provide /usr/share/cursor symlink pointing to /opt/cursor
    install -dm755 "${pkgdir}/usr/share"
    ln -s "../../opt/${_pkgname}" "${pkgdir}/usr/share/${_pkgname}"

    # 3. Binaries, launcher, and globalmenu C shim in /usr/bin and /opt/cursor
    install -Dm755 "${srcdir}/${pkgname}.sh" "${pkgdir}/usr/bin/${pkgname}"
    ln -sf "/opt/${_pkgname}/bin/cursor-tunnel" "${pkgdir}/usr/bin/cursor-tunnel"
    install -Dm755 "${srcdir}/lib${pkgname}-globalmenu.so" "${pkgdir}/opt/${_pkgname}/lib${pkgname}-globalmenu.so"

    # 4. Configuration flags in /etc
    install -Dm644 "${srcdir}/${pkgname}-flags.conf" "${pkgdir}/etc/${pkgname}-flags.conf"

    # 5. Desktop entries
    install -Dm644 "${srcdir}/${pkgname}.desktop" "${pkgdir}/usr/share/applications/${pkgname}.desktop"
    install -Dm644 "${srcdir}/${pkgname}-url-handler.desktop" "${pkgdir}/usr/share/applications/${pkgname}-url-handler.desktop"

    # 6. Icons
    install -Dm644 usr/share/pixmaps/co.anysphere.cursor.png \
        "${pkgdir}/usr/share/icons/hicolor/1024x1024/apps/${pkgname}.png"
    ln -sf "${pkgname}.png" "${pkgdir}/usr/share/icons/hicolor/1024x1024/apps/co.anysphere.cursor.png"

    install -Dm644 usr/share/pixmaps/co.anysphere.cursor.png \
        "${pkgdir}/usr/share/icons/hicolor/512x512/apps/${pkgname}.png"
    ln -sf "${pkgname}.png" "${pkgdir}/usr/share/icons/hicolor/512x512/apps/co.anysphere.cursor.png"

    install -Dm644 usr/share/pixmaps/co.anysphere.cursor.png \
        "${pkgdir}/usr/share/pixmaps/${pkgname}.png"
    ln -sf "${pkgname}.png" "${pkgdir}/usr/share/pixmaps/co.anysphere.cursor.png"

    # 7. Shell completions
    install -Dm644 usr/share/bash-completion/completions/cursor \
        "${pkgdir}/usr/share/bash-completion/completions/${pkgname}"
    install -Dm644 usr/share/zsh/vendor-completions/_cursor \
        "${pkgdir}/usr/share/zsh/site-functions/_${pkgname}"

    # 8. MIME package and AppStream metainfo
    install -Dm644 usr/share/mime/packages/cursor-workspace.xml \
        "${pkgdir}/usr/share/mime/packages/${pkgname}-workspace.xml"

    if [ -f usr/share/appdata/cursor.appdata.xml ]; then
        install -Dm644 usr/share/appdata/cursor.appdata.xml \
            "${pkgdir}/usr/share/metainfo/${pkgname}.appdata.xml"
        install -dm755 "${pkgdir}/usr/share/appdata"
        ln -sf "../metainfo/${pkgname}.appdata.xml" "${pkgdir}/usr/share/appdata/${pkgname}.appdata.xml"
    fi

    # 9. Licenses
    install -dm755 "${pkgdir}/usr/share/licenses/${pkgname}"
    install -Dm644 "${pkgdir}/opt/${_pkgname}/resources/app/LICENSE.txt" \
        "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE.txt"
    install -Dm644 "${pkgdir}/opt/${_pkgname}/LICENSES.chromium.html" \
        "${pkgdir}/usr/share/licenses/${pkgname}/LICENSES.chromium.html"
}
