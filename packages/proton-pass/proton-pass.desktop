[Desktop Entry]
Name=Proton Pass
GenericName=Password Manager
Comment=Proton official desktop application for Proton Pass
Exec=/usr/bin/proton-pass %U
Icon=proton-pass
Type=Application
Terminal=false
StartupNotify=true
StartupWMClass=Proton Pass
Categories=Utility;Security;
Keywords=Proton;Pass;Password;Passkey;Vault;
MimeType=x-scheme-handler/protonpass;
