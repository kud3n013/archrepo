_pkgname=proton-pass
pkgname=proton-pass
pkgver=1.41.0
pkgrel=1
pkgdesc="Official desktop application for Proton Pass: end-to-end encrypted password and identity manager (responsive layout & unconstrained resizing)"
arch=('x86_64')
url="https://proton.me/pass"
license=('GPL-3.0-or-later')
provides=('protonpass' "${pkgname}-bin")
conflicts=('protonpass' "${pkgname}-bin")
replaces=("${pkgname}-bin")
install=proton-pass.install
backup=("etc/${_pkgname}-flags.conf")
options=(!strip !debug)

depends=(
    'alsa-lib'
    'at-spi2-core'
    'cairo'
    'dbus'
    'expat'
    'glib2'
    'glibc'
