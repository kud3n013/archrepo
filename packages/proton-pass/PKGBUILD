prepare() {
    # Extract deb archive data payload
    tar -xf data.tar.xz

    local _app_dir="${srcdir}/usr/lib/${_pkgname}/resources"
    local _asar_file="${_app_dir}/app.asar"
    local _extract_dir="${srcdir}/app.asar.extracted"

    # Unpack asar archive
    rm -rf "${_extract_dir}"
    asar extract "${_asar_file}" "${_extract_dir}"

    # Apply window resizing unlock and responsive CSS rules
    node "${srcdir}/patch-pass.js" "${_extract_dir}"

    # Repack asar archive
    asar pack "${_extract_dir}" "${srcdir}/app.asar"
    mv -f "${srcdir}/app.asar" "${_asar_file}"
    rm -rf "${_extract_dir}"
}

package() {
    # Install application files into /opt/proton-pass
    install -dm755 "${pkgdir}/opt"
    cp -a "usr/lib/${_pkgname}" "${pkgdir}/opt/${_pkgname}"

    # Fix binary permissions
    chmod 755 "${pkgdir}/opt/${_pkgname}/Proton Pass"
    chmod -R o-w "${pkgdir}/opt/${_pkgname}/resources/assets" 2>/dev/null || true

    # Provide convenient unspaced symlink inside /opt/proton-pass
    ln -sf "Proton Pass" "${pkgdir}/opt/${_pkgname}/${_pkgname}"

    # Install launcher wrapper script
    install -Dm755 "${srcdir}/${_pkgname}.sh" "${pkgdir}/usr/bin/${_pkgname}"

    # Install system-wide flags configuration
    install -Dm644 "${srcdir}/${_pkgname}-flags.conf" "${pkgdir}/etc/${_pkgname}-flags.conf"

    # Install desktop entry
    install -Dm644 "${srcdir}/${_pkgname}.desktop" "${pkgdir}/usr/share/applications/${_pkgname}.desktop"

    # Install scalable SVG icon (borderless, transparent background)
    install -Dm644 "${srcdir}/${_pkgname}.svg" "${pkgdir}/usr/share/icons/hicolor/scalable/apps/${_pkgname}.svg"

    # Generate and install raster icon sizes across standard hicolor themes and pixmaps
    for size in 16 24 32 48 64 128 256 512; do
        install -dm755 "${pkgdir}/usr/share/icons/hicolor/${size}x${size}/apps"
        magick -background none "${srcdir}/${_pkgname}.svg" -resize "${size}x${size}" "PNG32:${pkgdir}/usr/share/icons/hicolor/${size}x${size}/apps/${_pkgname}.png"
    done
    install -Dm644 "${pkgdir}/usr/share/icons/hicolor/512x512/apps/${_pkgname}.png" "${pkgdir}/usr/share/pixmaps/${_pkgname}.png"

    # Also update in-app asset icons so window decorations use the clean emblem
    install -Dm644 "${pkgdir}/usr/share/icons/hicolor/512x512/apps/${_pkgname}.png" "${pkgdir}/opt/${_pkgname}/resources/assets/icon.png"
    install -Dm644 "${pkgdir}/usr/share/icons/hicolor/512x512/apps/${_pkgname}.png" "${pkgdir}/opt/${_pkgname}/resources/assets/logo.png"
    install -Dm644 "${srcdir}/${_pkgname}.svg" "${pkgdir}/opt/${_pkgname}/resources/assets/logo.svg"

    # Install licenses
    if [ -f "${pkgdir}/opt/${_pkgname}/LICENSES.chromium.html" ]; then
        install -Dm644 "${pkgdir}/opt/${_pkgname}/LICENSES.chromium.html" -t "${pkgdir}/usr/share/licenses/${pkgname}/"
    fi
    if [ -f "usr/share/doc/${_pkgname}/copyright" ]; then
        install -Dm644 "usr/share/doc/${_pkgname}/copyright" "${pkgdir}/usr/share/licenses/${pkgname}/copyright"
    fi

    # Fix directory and file permissions
    chmod -R u+rwX,go+rX,go-w "${pkgdir}"
    if [ -f "${pkgdir}/opt/${_pkgname}/chrome-sandbox" ]; then
        chmod 4755 "${pkgdir}/opt/${_pkgname}/chrome-sandbox"
    fi
}
