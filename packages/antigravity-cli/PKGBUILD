# Maintainer: kud3n013 <kud3n.013@proton.me>
# Upstream: https://antigravity.google/product/antigravity-cli
# AUR Reference: https://aur.archlinux.org/packages/antigravity-cli

pkgname=antigravity-cli
pkgver=1.4.5
_build=4952523841339392
pkgrel=1
pkgdesc="Google Antigravity CLI (agy), a terminal coding agent"
arch=('x86_64')
url="https://antigravity.google/product/antigravity-cli"
license=('LicenseRef-Google-Antigravity')
# The Go binary only links glibc (libc, libm, libpthread, libresolv, librt, libdl).
depends=('glibc')
provides=('agy' 'antigravity-cli-bin')
conflicts=('agy' 'antigravity-cli-bin')
replaces=('antigravity-cli-bin')
options=(!strip !debug !lto)
source=("cli_linux_x64-${pkgver}-${_build}.tar.gz::https://storage.googleapis.com/antigravity-public/antigravity-cli/${pkgver}-${_build}/linux-x64/cli_linux_x64.tar.gz"
        "agy.sh")
sha512sums=('fd30e8d256e28c4a6d0f5fddaa0f74b47c8c5a8e9fa2285cb03f85093e90eca0406f1c2fa57a0386bb820e21ed427e27c2315a01453dfda401c2223b2639ab30'
            '1157b9020098dde8eb2db14806efe78689bf562e563f8dad9d53da0ab5d4480d338d834f551a1e1b6a38f24eea4ad53c3bd00a718067f2ef1ec251d9313c7139')

package() {
    # The tarball holds a single binary named "antigravity"; that name belongs to
    # the desktop app, so the binary lives under /usr/lib and only "agy" is on PATH.
    install -Dm755 "${srcdir}/antigravity" "${pkgdir}/usr/lib/${pkgname}/agy"
    install -Dm755 "${srcdir}/agy.sh" "${pkgdir}/usr/bin/agy"

    chmod -R u+rwX,go+rX,go-w "${pkgdir}"
}
