# Maintainer: archrepo CI <ci@archrepo>
# Upstream: https://www.beeper.com/changelog

_pkgname=beeper
pkgname=beeper
pkgver=4.3.144
pkgrel=2
pkgdesc="The ultimate messaging app (formerly Beeper v4)"
arch=('x86_64')
url="https://www.beeper.com/changelog"
license=('LicenseRef-beeper')
provides=('beeper-bin' 'beeper-v4-bin')
conflicts=('beeper-bin' 'beeper-v4-bin')
replaces=('beeper-bin')
backup=("etc/${_pkgname}-flags.conf")
install=beeper.install
depends=(
    'glib2'
    'libappindicator-gtk3'
    'libnotify'
    'libsecret'
    'hicolor-icon-theme'
)
optdepends=(
    'appmenu-gtk-module: for KDE Plasma Global Menu support'
)
makedepends=(
    'asar'
)
options=(!strip !debug)
source=(
    "Beeper-${pkgver}-x86_64.AppImage::https://beeper-desktop.download.beeper.com/builds/Beeper-${pkgver}-x86_64.AppImage"
    "beeper.sh"
    "beeper.desktop"
    "beeper-flags.conf"
)
sha256sums=('0272fa8c451e6fdf7a061265a3bf656f41e006a36263e087b2c19ae4625d5f13'
            '765e2b3e39089e66f4f17697048330f36031b3bc18266d1c58bba4c7025ed28e'
            '690219ebbdde65466ca17b01e3b3c215ae94210ea89f71d084b2edb12c20ba32'
            '3d2101c089fd0a45c58a0e45f87b3a8d8465b63a7fdc701100859c691c0c2700')

prepare() {
    chmod +x "Beeper-${pkgver}-x86_64.AppImage"

    # Some filesystems (e.g. NTFS mounts) reject direct execution of AppImages.
    # Fall back to copying to /tmp for extraction if needed.
    local _appimage="Beeper-${pkgver}-x86_64.AppImage"
    local _extract_bin="./${_appimage}"
    if ! "${_extract_bin}" --appimage-help &>/dev/null; then
        _extract_bin="$(mktemp -u /tmp/beeper-XXXXXX.AppImage)"
        cp -f "${_appimage}" "${_extract_bin}"
        chmod +x "${_extract_bin}"
    fi

    rm -rf "${srcdir}/squashfs-root"
    "${_extract_bin}" --appimage-extract >/dev/null
    [ "${_extract_bin}" != "./${_appimage}" ] && rm -f "${_extract_bin}"

    # Explicitly set APPDIR in AppRun
    sed -Ei 's@^(if \[ -z "\$APPDIR" ] ; then)$@APPDIR="${APPDIR:-/opt/beeper}"\n\1@' "${srcdir}/squashfs-root/AppRun"

    local _app_dir="${srcdir}/squashfs-root/resources"
    local _asar_file="${_app_dir}/app.asar"
    local _extract_dir="${srcdir}/app.asar.extracted"

    # Extract asar archive
    asar extract "${_asar_file}" "${_extract_dir}"

    # Determine unpacked files glob for repacking
    local _unpacked_files_glob
    _unpacked_files_glob="{$(cd "${_asar_file}.unpacked" && find . -type f | sed -E 's,^\./,,' | paste -s -d, -)}"

    # Disable registerLinuxConfig to prevent duplicate/unmanaged desktop files in ~/.local/share/applications
    local _main_dir="${_extract_dir}/build/main"
    local _linux_config_file
    _linux_config_file=$(grep -lE 'export\{[a-zA-Z0-9_]+ as registerLinuxConfig\};' "${_main_dir}"/*.mjs | head -n1)
    if [ -n "${_linux_config_file}" ]; then
        sed -i 's/export{[a-zA-Z0-9_]* as registerLinuxConfig};/const noopFunc=function(){};export{noopFunc as registerLinuxConfig};/' "${_linux_config_file}"
    fi

    # Bridge XDG Desktop Portal color-scheme to Electron nativeTheme for dynamic dark/light switching
    python3 - <<'EOF' "${_main_dir}"
import sys, os, re, subprocess

main_dir = sys.argv[1]
main_file = None
for f in os.listdir(main_dir):
    if f.startswith("main-entry-") and f.endswith(".mjs"):
        p = os.path.join(main_dir, f)
        with open(p, "r", encoding="utf-8") as fp:
            content = fp.read()
        if "setNativeThemeSource" in content:
            main_file = p
            break

if not main_file:
    sys.exit("Error: setNativeThemeSource not found in main-entry files")

m_nt = re.search(r'nativeTheme\s+as\s+([a-zA-Z0-9_]+)', content)
nt_var = m_nt.group(1) if m_nt else "rm"

m_set = re.search(r'setNativeThemeSource\s*\(([a-zA-Z0-9_]+)\)\s*\{([^}]+)\}', content)
if not m_set:
    sys.exit("Error: setNativeThemeSource signature mismatch")
param = m_set.group(1)

# Prepend child_process import
content = 'import _portalChildProcess from "node:child_process";\n' + content

# Replace setNativeThemeSource in the object literal
m_set2 = re.search(r'setNativeThemeSource\s*\(([a-zA-Z0-9_]+)\)\s*\{([^}]+)\}', content)
replacement = f"setNativeThemeSource({param}){{_targetThemeSource={param};_applyPortalTheme();}}"
content = content[:m_set2.start()] + replacement + content[m_set2.end():]

# Append portal sync implementation cleanly at module level (bottom of file)
helper = f"""
let _targetThemeSource="system",_portalTheme="dark";
function _applyPortalTheme(){{
  const _newTheme=_targetThemeSource==="system"?_portalTheme:_targetThemeSource;
  try{{globalThis.logger?.log?.(`[PortalThemeSync] Applying themeSource: ${{_newTheme}} (target: ${{_targetThemeSource}}, portal: ${{_portalTheme}})`);}}catch(_){{}}
  {nt_var}.themeSource=_newTheme;
}}
function _initPortalThemeSync(){{
  try{{
    try{{
      const out=_portalChildProcess.execFileSync("gdbus",["call","--session","--dest","org.freedesktop.portal.Desktop","--object-path","/org/freedesktop/portal/desktop","--method","org.freedesktop.portal.Settings.Read","org.freedesktop.appearance","color-scheme"],{{timeout:1500,encoding:"utf8"}});
      if(out.includes("uint32 1"))_portalTheme="dark";
      else if(out.includes("uint32 2"))_portalTheme="light";
    }}catch(_){{
      try{{
        const out2=_portalChildProcess.execFileSync("dbus-send",["--session","--print-reply=literal","--dest=org.freedesktop.portal.Desktop","/org/freedesktop/portal/desktop","org.freedesktop.portal.Settings.Read","string:org.freedesktop.appearance","string:color-scheme"],{{timeout:1500,encoding:"utf8"}});
        if(out2.includes("uint32 1"))_portalTheme="dark";
        else if(out2.includes("uint32 2"))_portalTheme="light";
      }}catch(_){{}}
    }}
    _applyPortalTheme();
    const mon=_portalChildProcess.spawn("gdbus",["monitor","--session","--dest","org.freedesktop.portal.Desktop","--object-path","/org/freedesktop/portal/desktop"],{{stdio:["ignore","pipe","ignore"]}});
    mon.stdout.on("data",data=>{{
      const s=data.toString();
      if(s.includes("org.freedesktop.appearance")&&s.includes("color-scheme")){{
        if(s.includes("uint32 1")){{_portalTheme="dark";_applyPortalTheme();}}
        else if(s.includes("uint32 2")){{_portalTheme="light";_applyPortalTheme();}}
      }}
    }});
    mon.on("error",()=>{{}});
    process.on("exit",()=>{{try{{mon.kill();}}catch(_){{}}}});
  }}catch(_){{}}
}}
_initPortalThemeSync();
"""

content = content + "\n" + helper

with open(main_file, "w", encoding="utf-8") as fp:
    fp.write(content)

subprocess.run(["node", "-c", main_file], check=True)
print("Successfully patched and validated", os.path.basename(main_file), "with XDG portal theme sync")
EOF

    # Repack asar preserving unpacked native binaries
    asar pack --unpack "${_extract_dir}/${_unpacked_files_glob}" "${_extract_dir}" "${srcdir}/app.asar"

    # Sanity-check unpacked files
    local _fp
    while IFS= read -r -d '' _fp; do
        cmp "${_app_dir}/app.asar.unpacked/${_fp}" "${srcdir}/app.asar.unpacked/${_fp}" || return 1
    done < <(cd "${_app_dir}/app.asar.unpacked" && find . -type f -print0)

    mv -Tf "${srcdir}/app.asar" "${_asar_file}"
    rm -rf "${_extract_dir}" "${srcdir}/app.asar.unpacked"

    # Remove default desktop file from squashfs-root to prevent duplicate install
    rm -f "${srcdir}/squashfs-root/beepertexts.desktop"
}

package() {
    # Install application files to /opt/beeper
    install -dm755 "${pkgdir}/opt/beeper"
    cp -a "${srcdir}/squashfs-root/." "${pkgdir}/opt/beeper/"

    # Fix AppRun permissions
    chmod 755 "${pkgdir}/opt/beeper/AppRun"

    # Install wrapper script
    install -Dm755 "${srcdir}/beeper.sh" "${pkgdir}/usr/bin/beeper"

    # Install flags configuration
    install -Dm644 "${srcdir}/${_pkgname}-flags.conf" "${pkgdir}/etc/${_pkgname}-flags.conf"

    # Install desktop entry and Wayland app_id symlink
    install -Dm644 "${srcdir}/beeper.desktop" "${pkgdir}/usr/share/applications/beeper.desktop"
    ln -sf "beeper.desktop" "${pkgdir}/usr/share/applications/Beeper.desktop"

    # Install icons and matching Wayland app_id symlinks
    install -Dm644 "${srcdir}/squashfs-root/usr/share/icons/hicolor/512x512/apps/beepertexts.png" \
        "${pkgdir}/usr/share/icons/hicolor/512x512/apps/${_pkgname}.png"
    ln -sf "${_pkgname}.png" "${pkgdir}/usr/share/icons/hicolor/512x512/apps/Beeper.png"
    ln -sf "${_pkgname}.png" "${pkgdir}/usr/share/icons/hicolor/512x512/apps/beepertexts.png"

    # Install pixmaps
    install -Dm644 "${srcdir}/squashfs-root/usr/share/icons/hicolor/512x512/apps/beepertexts.png" \
        "${pkgdir}/usr/share/pixmaps/${_pkgname}.png"
    ln -sf "${_pkgname}.png" "${pkgdir}/usr/share/pixmaps/Beeper.png"
    ln -sf "${_pkgname}.png" "${pkgdir}/usr/share/pixmaps/beepertexts.png"

    # Install licenses
    install -Dm644 "${srcdir}/squashfs-root/LICENSE.electron.txt" -t "${pkgdir}/usr/share/licenses/${pkgname}/"
    install -Dm644 "${srcdir}/squashfs-root/LICENSES.chromium.html" -t "${pkgdir}/usr/share/licenses/${pkgname}/"

    # Fix permissions
    chmod -R u+rwX,go+rX,go-w "${pkgdir}"
}
