	optdepends = breeze-gtk: for matching KDE Plasma Breeze Qt window decorations and styling in GTK
	optdepends = kde-gtk-config: for synchronizing KDE Plasma window decorations with GTK applications
	optdepends = wl-clipboard: clipboard support on Wayland
