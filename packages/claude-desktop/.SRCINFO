	optdepends = libayatana-appindicator: system tray icon
	optdepends = xdg-desktop-portal-gtk: portal backend on GTK desktops
	optdepends = xdg-desktop-portal-kde: portal backend on KDE Plasma
	optdepends = bubblewrap: sandboxed command execution in Claude Code
	optdepends = socat: sandboxed command execution in Claude Code
