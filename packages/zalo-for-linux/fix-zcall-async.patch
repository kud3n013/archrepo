+function validateWineAsync(winePath, prefix) {
+  return new Promise((resolve) => {
+    const pipebridgePath = findPipebridgePath();
+    if (!pipebridgePath) {
+      debugLog('validate: pipebridge.exe not found (resourcesPath=' + (process.resourcesPath || '') + ')');
+      return resolve(false);
+    }
+    try {
+      const child = spawn(winePath, [pipebridgePath, '--version'], {
+        env: Object.assign({}, process.env, { WINEPREFIX: prefix, WINEDEBUG: '-all' })
+      });
+      let stdout = '';
+      let stderr = '';
+      if (child.stdout) child.stdout.on('data', d => { stdout += d.toString(); });
+      if (child.stderr) child.stderr.on('data', d => { stderr += d.toString(); });
+      const timer = setTimeout(() => {
+        try { child.kill(); } catch (_) {}
+        resolve(false);
+      }, 30000);
+      child.on('close', (code) => {
+        clearTimeout(timer);
+        if (code === 0 && /pipebridge/.test(stdout)) {
+          resolve(true);
+        } else {
+          debugLog('validate FAILED wine=' + winePath + ' code=' + code + ' stdout=' + stdout + ' stderr=' + stderr);
+          resolve(false);
+        }
+      });
+      child.on('error', (err) => {
+        clearTimeout(timer);
+        debugLog('validate error: ' + err.message);
+        resolve(false);
+      });
+    } catch (e) {
+      debugLog('validate exception: ' + e.message);
+      resolve(false);
+    }
+  });
+}
