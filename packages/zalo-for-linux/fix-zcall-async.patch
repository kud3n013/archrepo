 function launch({ userDataDir }) {
+  if (process.env.ZCALL_DISABLE) {
+    console.log('[zcall-bridge] ZCALL_DISABLE is set, skipping wine initialization');
+    return false;
+  }
+
+  // Defer initialization to background so Electron main thread and Wayland event loop never freeze
+  setTimeout(() => {
+    initWineAsync(userDataDir).catch((e) => {
+      console.error('[zcall-bridge] background wine init failed:', e);
+    });
+  }, 1500);
+  return true;
+}
