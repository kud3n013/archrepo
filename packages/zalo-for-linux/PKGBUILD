            '4a8cdce207c40ec4c0e2a7c60bf3e03c72103299961dad4b6d32eb436be16f69')

prepare() {
    cd "${srcdir}"

    # The AppImage is a uruntime executable with a DwarFS image appended. No DwarFS
    # tool is packaged in the Arch repos, so the runtime's own extractor is used. It
    # is statically linked and needs no FUSE. The tree is upstream's electron-builder
    # AppDir (squashfs-root is a symlink to it).
    chmod +x "${_appimage}"
    rm -rf AppDir squashfs-root
    "./${_appimage}" --appimage-extract >/dev/null

    # zalo.sh pins no GTK modules because Electron 22 links GTK directly and never
    # unloads it. A newer Electron that loads GTK at runtime needs the pin back.
    if ! objdump -p AppDir/zalo | grep -q 'NEEDED.*libgtk-3\.so\.0'; then
        echo "AppDir/zalo no longer links libgtk-3.so.0: review the GTK module pin in zalo.sh" >&2
        return 1
    fi

    # Add the bootstrap to app.asar. Only the entry point in package.json changes,
    # so the repacked archive must list upstream's files plus the archrepo files.
    local _asar="AppDir/resources/app.asar"
    asar list "${_asar}" | sort > asar-before.txt
    rm -rf app-src
    asar extract "${_asar}" app-src
    node patch-bootstrap.js app-src AppDir/app "${srcdir}"
    for _file in app-src/archrepo-*.js; do
        node --check "${_file}"
    done
    asar pack app-src "${_asar}"
    rm -rf app-src

    if ! asar list "${_asar}" | grep -v '^/archrepo-.*\.js$' | sort | diff asar-before.txt - ; then
        echo "app.asar differs from upstream beyond the archrepo files" >&2
        return 1
    fi
}

package() {
    cd "${srcdir}/AppDir"

    # 1. Application tree. The Electron binary finds its resources relative to its own
    #    path. AppRun and the AppImage desktop file are not needed. usr/ holds the icon
    #    (installed below) and libraries nothing loads: GTK2 libappindicator and
    #    libindicator, gconf, and copies of libnotify, libXss and libXtst.
    install -dm755 "${pkgdir}/opt/${pkgname}"
    cp -a . "${pkgdir}/opt/${pkgname}/"
    rm -rf "${pkgdir}/opt/${pkgname}"/{usr,AppRun,zalo.desktop,zalo.png,.DirIcon}

    # 2. Launcher.
    install -Dm755 "${srcdir}/zalo.sh" "${pkgdir}/usr/bin/zalo"
    ln -s zalo "${pkgdir}/usr/bin/zalo-for-linux"

    # 3. Flags file. Listed in backup= so user edits survive upgrades.
    install -Dm644 "${srcdir}/zalo-flags.conf" "${pkgdir}/etc/zalo-flags.conf"

    # 4. Desktop entry and icon (the same image as pc-dist/favicon-512x512.png).
    install -Dm644 "${srcdir}/zalo.desktop" "${pkgdir}/usr/share/applications/zalo.desktop"
    install -Dm644 usr/share/icons/hicolor/512x512/apps/zalo.png \
        "${pkgdir}/usr/share/icons/hicolor/512x512/apps/zalo.png"
    install -Dm644 usr/share/icons/hicolor/512x512/apps/zalo.png "${pkgdir}/usr/share/pixmaps/zalo.png"

    # 5. Licenses shipped with Electron.
    install -Dm644 LICENSE.electron.txt LICENSES.chromium.html -t "${pkgdir}/usr/share/licenses/${pkgname}/"

    chmod -R u+rwX,go+rX,go-w "${pkgdir}"
}
