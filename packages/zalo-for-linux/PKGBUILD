# Maintainer: kud3n013 <kud3n.013@proton.me>
# Upstream: https://github.com/VN-Linux-Family/zalo-for-linux

# Repackages upstream's ZaDark AppImage. The only change inside app.asar is a
# bootstrap (archrepo-bootstrap.js) that adds the KDE Global Menu, the window
# manager's title bar and live light/dark switching. It changes no upstream file
# and fails the build if upstream code it relies on is gone (patch-bootstrap.js).

pkgname=zalo-for-linux
pkgver=26.10.20
_zadarkver=26.3
_commithash=5a5c879
pkgrel=4
pkgdesc="Zalo for Linux (unofficial port with ZaDark), with KDE Global Menu, native title bar and live theme switching"
arch=('x86_64')
url="https://github.com/VN-Linux-Family/zalo-for-linux"
license=('MIT')
provides=('zalo' 'zalo-for-linux-bin' 'zalux-bin')
conflicts=('zalo' 'zalo-for-linux-bin' 'zalux-bin')
replaces=('zalo-for-linux-bin')
makedepends=('asar' 'nodejs')

# The Electron 22 binary and Zalo's native addons run against the system libraries
# (checked with objdump -p). Electron loads libnotify and libdbusmenu-glib at runtime.
# glib2 provides gdbus for the theme sync, xdg-utils the xdg-settings call at startup.
# The call engine runs on the bundled Electron (ELECTRON_RUN_AS_NODE), not on nodejs.
depends=(
    'alsa-lib'
    'at-spi2-core'
    'bash'
    'cairo'
    'dbus'
    'dbusmenu-shortcut-shim'
    'expat'
    'glib2'
    'glibc'
    'gtk3'
    'hicolor-icon-theme'
    'libcups'
    'libdbusmenu-glib'
    'libdrm'
    'libgcc'
    'libnotify'
    'libstdc++'
    'libx11'
    'libxcb'
    'libxcomposite'
    'libxdamage'
    'libxext'
    'libxfixes'
    'libxkbcommon'
    'libxrandr'
    'mesa'
    'nspr'
    'nss'
    'openssl'
    'pango'
    'xdg-utils'
    'xz'
)
# Only what current upstream calls: the native call engine, image paste and screenshots.
optdepends=(
    'python: voice and video calls'
    'opus: voice and video calls'
    'libpulse: voice and video calls (pactl, pacat, parec)'
    'wl-clipboard: paste images on Wayland'
    'xclip: paste images on X11 and XWayland'
    'spectacle: screenshots on KDE Plasma'
    'flameshot: screenshots'
    'gnome-screenshot: screenshots on GNOME'
)
backup=('etc/zalo-flags.conf')
install=${pkgname}.install
# Electron binaries break if stripped, and !debug is only meaningful for compiled packages.
options=('!strip' '!debug')

_appimage="Zalo-${pkgver}+ZaDark-${_zadarkver}-${_commithash}-x86_64.AppImage"
source=(
    "https://github.com/VN-Linux-Family/zalo-for-linux/releases/download/${pkgver}/${_appimage}"
    "zalo.sh"
    "zalo-flags.conf"
    "zalo.desktop"
    "patch-bootstrap.js"
    "archrepo-bootstrap.js"
    "archrepo-globalmenu.js"
    "archrepo-titlebar.js"
    "archrepo-theme.js"
    "archrepo-theme-preload.js"
)
sha256sums=('07e3356c913c603a15fd177cf6ee5950e8952289126b0305ceb23f5a37b8c462'
            '63442e64bebf91397e45ce9125241809fb1321ecc6b51c05f5b7cafcccc4c070'
