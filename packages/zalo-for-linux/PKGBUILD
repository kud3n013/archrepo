_pkgname=zalo
pkgname=zalo-for-linux
pkgver=26.10.10
_zadarkver=26.2.1
_commithash=0144208
pkgrel=1
pkgdesc="Zalo for Linux — unofficial port for Linux systems with ZaDark, Wayland & KDE integration"
arch=('x86_64')
url="https://github.com/VN-Linux-Family/zalo-for-linux"
license=('MIT')
provides=('zalo' 'zalo-for-linux-bin' 'zalux-bin')
conflicts=('zalo' 'zalo-for-linux-bin' 'zalux-bin')
replaces=('zalo-for-linux-bin')
install=zalo-for-linux.install
backup=('etc/zalo-flags.conf')
depends=(
    'bash'
    'glibc'
    'zlib'
    'gtk3'
    'nss'
    'alsa-lib'
    'libxss'
    'libxtst'
    'libdbusmenu-glib'
)
makedepends=(
    'asar'
    'glib2'
    'python'
)
optdepends=(
    # Desktop Environment Integration
    'appmenu-gtk-module: for KDE Plasma Global Menu support'

    # Clipboard & Screenshots
    'wl-clipboard: paste images from clipboard on Wayland'
    'xclip: paste images from clipboard on X11'
    'grim: screenshot tool on Wayland'
    'slurp: screenshot region selection on Wayland'
    'flameshot: screenshot tool'
    'spectacle: screenshot tool'

    # Audio/Video Calling (ZCall Bridge)
    'wine: Voice/Video call engine support (or download portable wine in-app)'
    'v4l-utils: control camera formats'
    'v4l2loopback-dkms: loopback camera support'

    # Wayland Screen Sharing Bridge
    'xorg-server-xvfb: headless X server for Wayland screen-sharing bridge'
    'xdotool: window resizing for screen bridge display'
    'gst-plugins-base: 64-bit GStreamer plugins for screen bridge'
    'gst-plugins-bad: 64-bit GStreamer plugins for screen bridge'
)
source=(
    "zalo.AppImage::https://github.com/VN-Linux-Family/zalo-for-linux/releases/download/${pkgver}/Zalo-${pkgver}+ZaDark-${_zadarkver}-${_commithash}-x86_64.AppImage"
    "patch-zalo.py"
    "zalo.desktop"
    "Zalo.png"
    "zalo.sh"
    "zalo-flags.conf"
    "zalo-globalmenu.c"
)
options=(!strip !debug)
sha256sums=('8e5bdf0db5f6a306562270585bbead12630576cb7286a99c64c97adee8cdfcc4'
            '80df0c5d4118036af1d73df1c29a546c9a70d6327a5bcca1155f4d93f8244769'
