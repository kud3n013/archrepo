# Maintainer: archrepo CI <ci@archrepo>
# AUR Reference: https://aur.archlinux.org/packages/millennium-bin
# Upstream: https://github.com/SteamClientHomebrew/Millennium

_pkgname=millennium
pkgname=millennium
pkgver=3.6.2
pkgrel=1
# Prereleases are stored without the hyphen (v3.6.0-beta.1 -> 3.6.0beta.1) so
# pacman sorts them before the final release; restore it for the upstream tag.
_tag="v${pkgver}"
[[ "$pkgver" =~ ^([0-9.]+)([a-z].*)$ ]] && _tag="v${BASH_REMATCH[1]}-${BASH_REMATCH[2]}"
pkgdesc="Open-source modding framework for creating and managing Steam Client themes and plugins"
arch=('x86_64')
url="https://github.com/SteamClientHomebrew/Millennium"
license=('MIT')
provides=("${_pkgname}-bin=${pkgver}")
conflicts=('millennium-bin' 'millennium-git')
replaces=('millennium-bin')
depends=('steam' 'lib32-openssl')
options=(!strip !debug)
install=millennium.install

source=(
    "${_pkgname}-${pkgver}.tar.gz::${url}/releases/download/${_tag}/millennium-${_tag}-linux-${arch}.tar.gz"
    "LICENSE-${pkgver}.md::https://raw.githubusercontent.com/SteamClientHomebrew/Millennium/${_tag}/LICENSE.md"
)
sha256sums=('95bda40184dd6437da1668060ec5961c762f3c1e59923f53380e43d4e720f359'
            'f01d1b8bce439ee29491817247a38611c41f7d1de4360b5577d4498d103fbf8b')

package() {
    # Install shared libraries and binaries to /usr/lib/millennium
    # The tarball extracts with a ./usr/lib/millennium/ structure
    install -d "${pkgdir}/usr/lib/millennium"
    install -m755 "${srcdir}/usr/lib/millennium/libmillennium_bootstrap_hhx64.so" "${pkgdir}/usr/lib/millennium/"
    install -m755 "${srcdir}/usr/lib/millennium/libmillennium_bootstrap_x86.so" "${pkgdir}/usr/lib/millennium/"
    install -m755 "${srcdir}/usr/lib/millennium/libmillennium_hhx64.so" "${pkgdir}/usr/lib/millennium/"
    install -m755 "${srcdir}/usr/lib/millennium/libmillennium_luavm_x86" "${pkgdir}/usr/lib/millennium/"
    install -m755 "${srcdir}/usr/lib/millennium/libmillennium_pvs64" "${pkgdir}/usr/lib/millennium/"
    install -m755 "${srcdir}/usr/lib/millennium/libmillennium_x86.so" "${pkgdir}/usr/lib/millennium/"

    # Install upstream license
    install -Dm644 "${srcdir}/LICENSE-${pkgver}.md" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE.md"

    # Ensure clean permissions
    chmod -R u+rwX,go+rX,go-w "${pkgdir}"
}
