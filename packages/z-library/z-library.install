_cleanup_user_desktops() {
    # Remove user-level copies of the entry left by manual or .deb-based installs,
    # so the launcher shows the packaged entry only.
    for user_home in /home/*; do
        if [ -d "$user_home/.local/share/applications" ]; then
            rm -f "$user_home/.local/share/applications/z-library.desktop" \
                  "$user_home/.local/share/applications/Z-Library.desktop" 2>/dev/null || true
        fi
    done
    update-desktop-database -q 2>/dev/null || true
    gtk-update-icon-cache -q -t -f usr/share/icons/hicolor 2>/dev/null || true
}

post_install() {
    _cleanup_user_desktops
}

post_upgrade() {
    _cleanup_user_desktops
}

post_remove() {
    _cleanup_user_desktops
}
