# Maintainer: kud3n013 <kud3n.013@proton.me>
# Upstream: https://proton.me/mail
# AUR Reference: https://aur.archlinux.org/packages/proton-mail-bin (repackages the same .deb)

# Repackaging of Proton's official Linux .deb (the "beta" channel is the only
# Linux build Proton publishes). The only change inside app.asar is a bootstrap
# that adds a system tray icon and close-to-tray (see tray-bootstrap.js) and makes
# the "Auto" theme follow the desktop's light/dark setting live (see theme-sync.js). The app
# icon and tray icon are this repository's own, not upstream's "Beta" badge icon.

pkgname=proton-mail
pkgver=1.15.1
pkgrel=3
pkgdesc="Proton official desktop application for Proton Mail and Proton Calendar (with system tray and close-to-tray)"
arch=('x86_64')
url="https://proton.me/mail"
license=('GPL-3.0-or-later')
makedepends=('asar' 'nodejs' 'imagemagick' 'librsvg')
depends=(
    'alsa-lib'
    'glib2'
    'gtk3'
    'hicolor-icon-theme'
    'libdrm'
    'libxkbcommon'
    'mesa'
    'nss'
)
optdepends=(
    'gnome-shell-extension-appindicator: tray icon on GNOME Shell'
    'libnotify: desktop notifications'
    'org.freedesktop.secrets: sign-in storage via Secret Service (gnome-keyring or kwallet)'
    'xdg-utils: open links in the default browser and check the default mail app'
)
provides=('proton-mail-bin' 'proton-mail-desktop')
conflicts=('proton-mail-bin' 'proton-mail-desktop')
replaces=('proton-mail-bin')
backup=("etc/${pkgname}-flags.conf")
# Electron binaries break if stripped, and !debug is only meaningful for compiled packages.
options=('!strip' '!debug')

_deb="${pkgname}-${pkgver}.deb"
source=(
    "${_deb}::https://proton.me/download/mail/linux/${pkgver}/ProtonMail-desktop-beta.deb"
    "${pkgname}.sh"
    "${pkgname}-flags.conf"
    "${pkgname}.desktop"
    "${pkgname}.png"
    "${pkgname}-tray.svg"
    "patch-tray.js"
    "tray-bootstrap.js"
    "theme-sync.js"
)
# makepkg would unpack the .deb into $srcdir, but only data.tar.xz is needed.
noextract=("${_deb}")
sha256sums=('583616c195b2fa05449213732d23ca753d00c7b4cc2e5cf17af9c5022ee69c31'
            'f5ba7c5a0feb616eec9464bd5a83cf5801ae524c08802dec2f37157451f4647a'
            'b88ac136df39b17a1a92b18e267b0817620130da560f8af096c7ce05549d66e8'
            'a3e3c159ea17cb46507e711b1ce98f8e548088abd462245e2f609ebab3684b41'
            '9a84b663bc99285a368366da54a06a614b564b05c92b9e78669b27c4545d3773'
            '2cf6f56e7ac141fcc13e7b3bc3dbf19542910acee86bdc52f5ba3ee92e195997'
            'f8112e227b2613bdfa9cde31a7e62dbf722bf952363dfb046fef01372d67146e'
            '50ac76347517f3a231a6de60ef3c88dadd68e2d3d93bba801d5010cad461b62b'
            '76e3f02a50b1e892212633cb49f4acd0df6fd51bfeaf94b3652e85fdea053cf6')

prepare() {
    cd "${srcdir}"

    bsdtar -xf "${_deb}" data.tar.xz
    rm -rf data
    mkdir -p data
    bsdtar -xf data.tar.xz -C data

    # Add the bootstrap and its theme sync module to app.asar. Only the entry
    # point in package.json changes. Electron Forge unpacks native modules (*.node) next to the archive,
    # so the repack must come out with the same unpacked file list.
    local _resources="data/usr/lib/${pkgname}/resources"
    local _unpacked="${_resources}/app.asar.unpacked"
    if [ -d "${_unpacked}" ]; then
        (cd "${_unpacked}" && find . -type f | sort) > "${srcdir}/unpacked-before.txt"
    else
        : > "${srcdir}/unpacked-before.txt"
    fi

    rm -rf "${srcdir}/app-src"
    asar extract "${_resources}/app.asar" "${srcdir}/app-src"
    node "${srcdir}/patch-tray.js" "${srcdir}/app-src" "${srcdir}/tray-bootstrap.js" "${srcdir}/theme-sync.js"
    node --check "${srcdir}/app-src/archrepo-bootstrap.js"
    node --check "${srcdir}/app-src/archrepo-theme-sync.js"

    rm -rf "${_unpacked}"
    asar pack "${srcdir}/app-src" "${_resources}/app.asar" --unpack '*.node'
    rm -rf "${srcdir}/app-src"

    if ! { [ -d "${_unpacked}" ] && (cd "${_unpacked}" && find . -type f | sort) ; } \
            | diff "${srcdir}/unpacked-before.txt" - ; then
        echo "app.asar.unpacked differs from upstream" >&2
        return 1
    fi

    # Tray icon, read by the bootstrap from the resources directory. The SVG is
    # not square, so it is centred on a square canvas. Electron picks up the @2x
    # file on scaled displays.
    magick -background none "${srcdir}/${pkgname}-tray.svg" -resize 64x64 -gravity center -extent 64x64 \
        PNG32:"${_resources}/tray.png"
    magick -background none "${srcdir}/${pkgname}-tray.svg" -resize 128x128 -gravity center -extent 128x128 \
        PNG32:"${_resources}/tray@2x.png"

    # Window icon (X11/XWayland). Upstream ships its own icon.png here; use the
    # same icon as the launcher entry.
    install -m644 "${srcdir}/${pkgname}.png" "${_resources}/icon.png"
}

package() {
    cd "${srcdir}/data"

    # Application tree. The Electron binary finds its resources relative to its
    # own path, so the tree is kept whole under /opt.
    install -dm755 "${pkgdir}/opt/${pkgname}"
    cp -a "usr/lib/${pkgname}/." "${pkgdir}/opt/${pkgname}/"

    # Upstream names the binary after the product ("Proton Mail Beta"). Its
    # /usr/bin/proton-mail symlink says which file that is; give it a name
    # without spaces for the launcher.
    local _bin
    _bin="$(basename "$(readlink "usr/bin/${pkgname}")")"
    if [ ! -x "usr/lib/${pkgname}/${_bin}" ]; then
        echo "cannot find the Electron binary from usr/bin/${pkgname}" >&2
        return 1
    fi
    ln -s "${_bin}" "${pkgdir}/opt/${pkgname}/${pkgname}"

    # Launcher, in place of upstream's /usr/bin/proton-mail symlink.
    install -Dm755 "${srcdir}/${pkgname}.sh" "${pkgdir}/usr/bin/${pkgname}"

    # Flags file. Listed in backup= so user edits survive upgrades.
    install -Dm644 "${srcdir}/${pkgname}-flags.conf" "${pkgdir}/etc/${pkgname}-flags.conf"

    # Desktop entry. The app checks for /usr/share/applications/proton-mail.desktop
    # by that exact name when it asks whether it is the default mail app.
    install -Dm644 "${srcdir}/${pkgname}.desktop" "${pkgdir}/usr/share/applications/${pkgname}.desktop"

    # Icons. Only this repository's PNG is installed under the proton-mail name.
    # Upstream's scalable icon (usr/share/pixmaps/proton-mail.png, an SVG with a
    # "Beta" badge) is left out: icon themes prefer scalable icons, so shipping it
    # would hide the PNG.
    install -Dm644 "${srcdir}/${pkgname}.png" "${pkgdir}/usr/share/icons/hicolor/512x512/apps/${pkgname}.png"
    install -Dm644 "${srcdir}/${pkgname}.png" "${pkgdir}/usr/share/pixmaps/${pkgname}.png"

    # Licenses
    install -Dm644 "usr/lib/${pkgname}/LICENSES.chromium.html" -t "${pkgdir}/usr/share/licenses/${pkgname}/"
    if [ -f "usr/lib/${pkgname}/LICENSE" ]; then
        install -Dm644 "usr/lib/${pkgname}/LICENSE" -t "${pkgdir}/usr/share/licenses/${pkgname}/"
    fi

    chmod -R u+rwX,go+rX,go-w "${pkgdir}"

    # Chromium's setuid sandbox helper. The extraction above drops the setuid bit
    # for an unprivileged build user, so set it explicitly after the chmod. It only
    # matters when unprivileged user namespaces are unavailable.
    if [ -f "${pkgdir}/opt/${pkgname}/chrome-sandbox" ]; then
        chmod 4755 "${pkgdir}/opt/${pkgname}/chrome-sandbox"
    fi
}
