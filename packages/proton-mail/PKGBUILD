# Maintainer: archrepo CI <ci@archrepo>
# Upstream: https://proton.me/mail
# AUR Reference: https://aur.archlinux.org/packages/proton-mail-bin

_pkgname=proton-mail
pkgname=proton-mail
pkgver=1.15.0
pkgrel=1
pkgdesc="Proton official desktop application for Proton Mail and Proton Calendar (with system tray & close-to-tray)"
arch=('x86_64')
url="https://proton.me/mail"
license=('GPL-3.0-or-later')
provides=('proton-mail-bin' 'proton-mail-desktop')
conflicts=('proton-mail-bin' 'proton-mail-desktop')
replaces=('proton-mail-bin')
install=proton-mail.install
backup=('etc/proton-mail-flags.conf')
depends=(
    'gtk3'
    'nss'
    'alsa-lib'
    'libxss'
    'libxtst'
    'hicolor-icon-theme'
)
optdepends=(
    'libappindicator: AppIndicator system tray support on modern desktops'
    'gnome-shell-extension-appindicator: AppIndicator support for GNOME Shell'
    'libnotify: desktop notifications'
    'wl-clipboard: clipboard support on Wayland'
    'xdg-utils: default browser and URL handling'
    'org.freedesktop.secrets: keychain/credential storage via Secret Service'
)
makedepends=(
    'asar'
    'imagemagick'
    'librsvg'
)
options=(!strip !debug)
source=(
    "${_pkgname}-${pkgver}.deb::https://proton.me/download/mail/linux/${pkgver}/ProtonMail-desktop-beta.deb"
    "proton-mail-tray.svg::https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg/proton-mail.svg"
    "proton-mail.sh"
    "proton-mail-flags.conf"
    "proton-mail.desktop"
    "proton-mail.png"
    "patch-tray.js"
)
sha256sums=('098af5b82834f3da184f7f71a02d28c44884590a8055b51752221c758f5eccb2'
            '2cf6f56e7ac141fcc13e7b3bc3dbf19542910acee86bdc52f5ba3ee92e195997'
            'b89e1368579dcf974c0178190ebddbce6b9241f4e521a2b5fde4c5cba3386d30'
            '06e5754ed70170df93823bf62805a1f82da773ef92d6210f14209298d43908c6'
            '8099d23ec71f2074dc874a5487808aacfd56ece2c40110e98f62ed725b3180cd'
            '9a84b663bc99285a368366da54a06a614b564b05c92b9e78669b27c4545d3773'
            'f46fd7872b53e859fcb5ef0037669225a461967c300ae937ee9d07ac79b61e9a')

prepare() {
    # Extract data.tar.xz from Debian package
    ar x "${_pkgname}-${pkgver}.deb" data.tar.xz
    tar -xf data.tar.xz

    local _app_dir="${srcdir}/usr/lib/proton-mail/resources"
    local _asar_file="${_app_dir}/app.asar"
    local _extract_dir="${srcdir}/app.asar.extracted"

    # Unpack asar archive
    rm -rf "${_extract_dir}"
    asar extract "${_asar_file}" "${_extract_dir}"

    # Apply system tray and close-to-tray modifications
    node "${srcdir}/patch-tray.js" "${_extract_dir}/.webpack/main/index.js"

    # Repack asar archive
    asar pack "${_extract_dir}" "${srcdir}/app.asar"
    mv -f "${srcdir}/app.asar" "${_asar_file}"
    rm -rf "${_extract_dir}"

    # Ensure blank.html has dark background to avoid white flash during transitions
    sed -i 's|<body></body>|<body style="background-color:#16141c;"></body>|' "${_app_dir}/blank.html"

    # Generate crisp 64x64 square tray icon from the dedicated tray SVG
    magick -background none "${srcdir}/proton-mail-tray.svg" -resize 64x64 -gravity center -extent 64x64 PNG32:"${_app_dir}/tray.png"
}

package() {
    # Install application files to /opt/proton-mail
    install -dm755 "${pkgdir}/opt/${_pkgname}"
    cp -a "${srcdir}/usr/lib/proton-mail/." "${pkgdir}/opt/${_pkgname}/"

    # Set executable permissions on binary
    chmod 755 "${pkgdir}/opt/${_pkgname}/Proton Mail Beta"
    chmod 755 "${pkgdir}/opt/${_pkgname}/chrome-sandbox" 2>/dev/null || true

    # Provide clean symlink without spaces
    ln -sf "Proton Mail Beta" "${pkgdir}/opt/${_pkgname}/${_pkgname}"

    # Install launcher wrapper script
    install -Dm755 "${srcdir}/${_pkgname}.sh" "${pkgdir}/usr/bin/${_pkgname}"

    # Install system-wide default flags file
    install -Dm644 "${srcdir}/${_pkgname}-flags.conf" "${pkgdir}/etc/${_pkgname}-flags.conf"

    # Install desktop entry
    install -Dm644 "${srcdir}/${_pkgname}.desktop" "${pkgdir}/usr/share/applications/${_pkgname}.desktop"

    # Install icons (512x512 PNG, pixmaps PNG, scalable SVG)
    install -Dm644 "${srcdir}/${_pkgname}.png" "${pkgdir}/usr/share/icons/hicolor/512x512/apps/${_pkgname}.png"
    install -Dm644 "${srcdir}/${_pkgname}.png" "${pkgdir}/usr/share/pixmaps/${_pkgname}.png"
    if [ -f "${srcdir}/usr/share/pixmaps/proton-mail.png" ]; then
        install -Dm644 "${srcdir}/usr/share/pixmaps/proton-mail.png" "${pkgdir}/usr/share/icons/hicolor/scalable/apps/${_pkgname}.svg"
    fi
    install -Dm644 "${srcdir}/proton-mail-tray.svg" "${pkgdir}/usr/share/icons/hicolor/scalable/apps/proton-mail-tray.svg"
    install -Dm644 "${pkgdir}/opt/${_pkgname}/resources/tray.png" "${pkgdir}/usr/share/icons/hicolor/64x64/apps/proton-mail-tray.png"

    # Install licenses if available
    if [ -f "${srcdir}/usr/lib/proton-mail/LICENSES.chromium.html" ]; then
        install -Dm644 "${srcdir}/usr/lib/proton-mail/LICENSES.chromium.html" -t "${pkgdir}/usr/share/licenses/${pkgname}/"
    fi

    # Fix overall permissions
    chmod -R u+rwX,go+rX,go-w "${pkgdir}"
}
