pkgbase = craft-anything
	pkgdesc = Craft Anything, ArtCraft's open-source tool that studies how software works and has a coding agent build your own version
	pkgver = 0.4.0
	pkgrel = 1
	url = https://github.com/storytold/craft-anything
	arch = x86_64
	license = MIT OR Apache-2.0
	license = OFL-1.1
	depends = glibc
	depends = gcc-libs
	depends = hicolor-icon-theme
	depends = dbus
	depends = libxkbcommon
	depends = libxkbcommon-x11
	depends = libx11
	depends = libxcb
	depends = libxcursor
	depends = libxi
	depends = wayland
	depends = libglvnd
	depends = vulkan-icd-loader
	optdepends = vulkan-driver: GPU rendering through Vulkan (falls back to OpenGL or the CPU)
	optdepends = xdg-desktop-portal: native file dialogs
	optdepends = zenity: file dialogs without a portal
	optdepends = xdg-utils: open links in the browser
	optdepends = claude-code: the coding agent that builds projects (AUR or Anthropic's installer)
	optdepends = openai-codex: Codex as the coding agent
	optdepends = gemini-cli: Gemini CLI as the coding agent (through ACP)
	optdepends = opencode: opencode as the coding agent (through ACP)
	optdepends = chromium: study websites (Chrome, Edge and Brave work too)
	optdepends = ghidra: decompiler in Deep mode
	optdepends = android-tools: study apps on a connected phone (adb)
	optdepends = jadx: decompile Android apps
	provides = craft-anything-bin
	conflicts = craft-anything-bin
	conflicts = craft-anything-git
	replaces = craft-anything-bin
	options = !strip
	options = !debug
	source = craft-anything-0.4.0-linux-x86_64.tar.gz::https://github.com/storytold/craft-anything/releases/download/v0.4.0/craft-anything-0.4.0-linux-x86_64.tar.gz
