# Maintainer: kud3n013 <kud3n013@gmail.com>

pkgname=kwin-scripts-krohnkite
_pkgname=krohnkite
pkgver=0.9.10.0.r45.gfef8405
pkgrel=1
pkgdesc="A dynamic tiling extension for KWin (KDE Plasma 6)"
arch=('any')
url="https://codeberg.org/kud3n/Krohnkite"
license=('MIT')
# python: iconinstaller.qml runs contents/code/install-icons.py on load
depends=('kwin' 'python')
makedepends=('git' 'npm' 'gettext')
provides=("${_pkgname}")
conflicts=("${_pkgname}" "${pkgname}-git")
options=('!strip' '!debug')
install="${pkgname}.install"

# kud3n's fork: anametologin's master plus the pointer options sent upstream
# as PRs #75 and #76. check-upstream.sh moves _commithash to the branch head.
_gitbranch="local/pointer-combined"
_commithash=fef84058af7faf71f04c574d53f13b2c308b2d0c
source=("${_pkgname}::git+${url}.git#commit=${_commithash}")
sha256sums=('SKIP')

pkgver() {
  cd "${_pkgname}"
  git describe --long --tags | sed 's/\([^-]*-g\)/r\1/;s/-/./g'
}

build() {
  cd "${_pkgname}"
  export npm_config_cache="${srcdir}/npm-cache"
  # A second make over an existing pkg/ deletes metadata.json without rebuilding it
  rm -rf pkg
  make all

  # make leaves translations out; upstream releases ship them compiled
  local pair
  for pair in ru:russian zh:chinese; do
    install -dm755 "pkg/contents/locale/${pair%%:*}/LC_MESSAGES"
    msgfmt --check -o "pkg/contents/locale/${pair%%:*}/LC_MESSAGES/${_pkgname}.mo" \
      "translations/${pair##*:}.po"
  done
}

package() {
  cd "${_pkgname}"
  install -dm755 "${pkgdir}/usr/share/kwin/scripts/${_pkgname}"
  cp -r --no-preserve=ownership pkg/. "${pkgdir}/usr/share/kwin/scripts/${_pkgname}/"

  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"

  # Ensure consistent directory and file permissions
  chmod -R u+rwX,go+rX,go-w "${pkgdir}"
}
