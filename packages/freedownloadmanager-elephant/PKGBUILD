# Maintainer: archrepo CI <ci@archrepo>
# Contributor: meowcateatrat <https://github.com/meowcateatrat>

pkgname=freedownloadmanager-elephant
pkgver=1.3.12
pkgrel=1
pkgdesc="Free Download Manager add-on for downloading videos from various sites (powered by yt-dlp)"
arch=('any')
url="https://github.com/meowcateatrat/elephant"
license=('MIT')
provides=("${pkgname}-bin")
conflicts=("${pkgname}-bin")
install="${pkgname}.install"
options=(!strip !debug)

depends=(
    'freedownloadmanager'
    'deno'
    'python'
)

source=(
    "${pkgname}-${pkgver}.fda::https://github.com/meowcateatrat/elephant/releases/download/${pkgver}/elephant.fda"
    "LICENSE-${pkgver}::https://raw.githubusercontent.com/meowcateatrat/elephant/${pkgver}/LICENSE"
)
noextract=("${pkgname}-${pkgver}.fda")
sha512sums=('b10fb88ecb1d4e7b2faeddd8235d050cce8fd49db3ac453ed17d547692718fdddd52d0f7a7717f168ede657a4c74b2b7b488b234e74b302f2ac61ba047a94130'
            '912e814f244d8016b8b476e9d9aa88efc6c0829383c3d6e7447ab5a597624debf55ae18925399228c8b5dfa3183914f605485748ce1cadf61a5c07c946bddec1')

prepare() {
    rm -rf "${srcdir}/plugin"
    mkdir -p "${srcdir}/plugin"
    bsdtar -xf "${srcdir}/${pkgname}-${pkgver}.fda" -C "${srcdir}/plugin"
}

package() {
    local target="${pkgdir}/usr/share/freedownloadmanager/plugins/elephant"
    install -dm755 "${target}"
    cp -a "${srcdir}/plugin/." "${target}/"

    # Install upstream license
    install -Dm644 "${srcdir}/LICENSE-${pkgver}" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"

    # Fix directory and file permissions
    chmod -R u+rwX,go+rX,go-w "${pkgdir}"
}
