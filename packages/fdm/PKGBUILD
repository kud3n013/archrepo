_pkgname=freedownloadmanager
pkgname=fdm
pkgver=6.34.4.6974
pkgrel=5
pkgdesc="Fast and powerful modern download accelerator and organizer (binary release)"
arch=('x86_64')
url="https://www.freedownloadmanager.org/"
license=('Freeware')
# Renamed from freedownloadmanager; replaces= moves existing installs over on -Syu.
# extra/fdm (the mail fetcher) shares the name and /usr/bin/fdm, hence the conflict.
provides=("${_pkgname}" "${_pkgname}-bin")
conflicts=("${_pkgname}" "${_pkgname}-bin")
replaces=("${_pkgname}" "${_pkgname}-bin")
install="${pkgname}.install"
backup=("etc/${_pkgname}-flags.conf")
options=(!strip !debug)

makedepends=(
    'patchelf'
    'qt6-declarative'
)

depends=(
    'alsa-lib'
    'bubblewrap'
    'dbus'
    'ffmpeg'
    'fontconfig'
    'freetype2'
    'gcc-libs'
    'glibc'
    'hicolor-icon-theme'
    'libglvnd'
    'libpulse'
    'libx11'
    'libxcb'
    'libxkbcommon'
    'libxkbcommon-x11'
    'openssl'
    'wayland'
    'xcb-util'
    'xcb-util-cursor'
    'xcb-util-image'
    'xcb-util-keysyms'
    'xcb-util-renderutil'
    'xcb-util-wm'
    'xdg-utils'
    'zlib'
    'zstd'
)

optdepends=(
    'gst-plugins-base: multimedia playback support'
    'qt6-wayland: native Wayland display server support'
)

source=(
    "${pkgname}-${pkgver}-amd64.deb::https://files2.freedownloadmanager.org/6/latest/freedownloadmanager.deb"
    "${_pkgname}.sh"
    "${_pkgname}-flags.conf"
    "${_pkgname}.desktop"
    "${_pkgname}.png"
    "fdm-theme-fix.c"
    "fdm-globalmenu.cpp"
    "GlobalMenuBar.qml"
)
