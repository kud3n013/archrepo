pkgname=zed
pkgver=1.21.0
pkgrel=1
pkgdesc="A high-performance, multiplayer code editor from the creators of Atom and Tree-sitter"
arch=('x86_64')
url="https://zed.dev"
_url="https://github.com/zed-industries/${pkgname}"
license=('GPL-3.0-or-later' 'AGPL-3.0-or-later' 'Apache-2.0')
depends=(
  'alsa-lib'
  'curl'
  'fontconfig'
  'git'
  'glib2'
  'glibc'
  'libgcc'
  'libstdc++'
  'libxcb'
  'libx11'
  'libxkbcommon'
  'libxkbcommon-x11'
  'netcat'
  'nodejs>=18'
  'npm'
  'sqlite'
  'vulkan-driver'
  'vulkan-icd-loader'
  'vulkan-tools'
  'wayland'
  'zstd'
)
makedepends=(
  'cargo'
  'cargo-about'
  'clang'
  'cmake'
  'gettext'
  'protobuf'
  'vulkan-headers'
  'vulkan-validation-layers'
)
optdepends=(
  'org.freedesktop.secrets: to keep you logged into your Zed account'
  'clang: improved C/C++ language support'
  'rust-analyzer: improved Rust language support'
)
provides=(
  "${pkgname}-bin"
  "${pkgname}-editor"
  "zeditor"
)
conflicts=(
  "${pkgname}-bin"
  "${pkgname}-editor"
)
replaces=(
  "${pkgname}-bin"
  "${pkgname}-editor"
)
options=('!debug')
backup=("etc/${pkgname}-flags.conf")
install="${pkgname}.install"

_archive="${pkgname}-${pkgver}"
_appid="dev.zed.Zed"

source=(
  "${_url}/archive/v${pkgver}/${_archive}.tar.gz"
  "${pkgname}.sh"
  "${pkgname}-flags.conf"
  "${pkgname}.desktop"
)
sha256sums=(
  '37356f2cb6ca4714937be200edad278cb0f6137b4c3eec66a0743b5f523e1ee5'
  '3b77e3a9c2df8d2aecab9179c4215d6ce1f4d9060623f71a54d1933c6f359589'
  'fe562f2e57b5e8bc332bd27eb44fcdeb4dadbb756c74a456f7d2e9f6b9a0d4f5'
  '0b08d365118d8e95ddb8b2d611bd596bfee3b2cdceed502227c2bccbba8c270a'
)

_srcenv() {
  cd "${srcdir}/${_archive}"
  export CARGO_HOME="${srcdir}/cargo-home"
  export CARGO_PROFILE_RELEASE_DEBUG=0
  export CARGO_PROFILE_RELEASE_STRIP=false
  export CARGO_PROFILE_RELEASE_LTO=thin
  export CARGO_PROFILE_RELEASE_OPT_LEVEL=3
  CFLAGS+=' -ffat-lto-objects'
  CXXFLAGS+=' -ffat-lto-objects'
  RUSTFLAGS+=" --remap-path-prefix ${PWD}=/"
  export LIBSQLITE3_SYS_USE_PKG_CONFIG=1
  export ZSTD_SYS_USE_PKG_CONFIG=1
}

prepare() {
  _srcenv
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"

  export DO_STARTUP_NOTIFY="true"
  export APP_ICON="${pkgname}"
  export APP_NAME="Zed"
  export APP_CLI="${pkgname}"
  export APP_ID="${_appid}"
  export APP_ARGS="%U"
  export BRANDING_LIGHT="#99c1f1"
  export BRANDING_DARK="#1a5fb4"

  envsubst < "crates/zed/resources/flatpak/zed.metainfo.xml.in" > "${_appid}.metainfo.xml"
  sed -i '/@release_info@/d' "${_appid}.metainfo.xml"

  # Allow system cargo-about if installed
  sed -i 's/grep "cargo-about $CARGO_ABOUT_VERSION"/grep -E "cargo-about [0-9]+\.[0-9]+"/g' script/generate-licenses
  ./script/generate-licenses
}

build() {
  _srcenv
  export ZED_UPDATE_EXPLANATION='Updates are handled by pacman'
  export RELEASE_VERSION="${pkgver}"
  export PROTOC=/usr/bin/protoc
  export PROTOC_INCLUDE=/usr/include

  cargo build --release --frozen --package zed --package cli

  target/release/cli --completions bash > completions.bash
  target/release/cli --completions fish > completions.fish
  target/release/cli --completions zsh > completions.zsh
}

check() {
  _srcenv
  # Headless CI containers lack physical GPU/Vulkan ICD display surfaces
  # cargo test --frozen --package zed --package cli
}

package() {
  depends+=(
    'libasound.so'
    'libgio-2.0.so' 'libglib-2.0.so' 'libgobject-2.0.so'
    'libgcc_s.so'
    'libstdc++.so'
    'libxkbcommon.so'
    'libxkbcommon-x11.so'
    'libsqlite3.so'
    'libzstd.so'
  )

  cd "${srcdir}/${_archive}"

  # Internal binaries
  install -Dm0755 target/release/zed "${pkgdir}/usr/lib/${pkgname}/zed-editor"
  ln -s zed-editor "${pkgdir}/usr/lib/${pkgname}/zed"
  install -Dm0755 target/release/cli "${pkgdir}/usr/lib/${pkgname}/zed-cli"

  # Launcher wrapper & symlink
  install -Dm0755 "${srcdir}/${pkgname}.sh" "${pkgdir}/usr/bin/${pkgname}"
  ln -s "${pkgname}" "${pkgdir}/usr/bin/zeditor"

  # User flags configuration template
  install -Dm0644 "${srcdir}/${pkgname}-flags.conf" "${pkgdir}/etc/${pkgname}-flags.conf"

  # Desktop entries
  install -Dm0644 "${srcdir}/${pkgname}.desktop" "${pkgdir}/usr/share/applications/${_appid}.desktop"
  ln -s "${_appid}.desktop" "${pkgdir}/usr/share/applications/${pkgname}.desktop"

  # AppStream metainfo
  install -Dm0644 "${_appid}.metainfo.xml" "${pkgdir}/usr/share/metainfo/${_appid}.metainfo.xml"

  # Icons
  install -Dm0644 crates/zed/resources/app-icon.png "${pkgdir}/usr/share/icons/hicolor/512x512/apps/${pkgname}.png"
  install -Dm0644 crates/zed/resources/app-icon@2x.png "${pkgdir}/usr/share/icons/hicolor/1024x1024/apps/${pkgname}.png"
  install -Dm0644 crates/zed/resources/app-icon.png "${pkgdir}/usr/share/pixmaps/${pkgname}.png"

  # Shell completions
  install -Dm0644 completions.bash "${pkgdir}/usr/share/bash-completion/completions/${pkgname}"
  ln -s "${pkgname}" "${pkgdir}/usr/share/bash-completion/completions/zeditor"

  install -Dm0644 completions.fish "${pkgdir}/usr/share/fish/vendor_completions.d/${pkgname}.fish"
  ln -s "${pkgname}.fish" "${pkgdir}/usr/share/fish/vendor_completions.d/zeditor.fish"

  install -Dm0644 completions.zsh "${pkgdir}/usr/share/zsh/site-functions/_${pkgname}"
  ln -s "_${pkgname}" "${pkgdir}/usr/share/zsh/site-functions/_zeditor"

  # Licenses
  install -Dm0644 -t "${pkgdir}/usr/share/licenses/${pkgname}" assets/licenses.md LICENSE-AGPL LICENSE-APACHE LICENSE-GPL
}
