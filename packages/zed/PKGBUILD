# Maintainer: kud3n013 <kud3n.013@proton.me>

pkgname=zed
pkgver=1.21.0
pkgrel=1
pkgdesc="A high-performance, multiplayer code editor from the creators of Atom and Tree-sitter"
arch=('x86_64')
url="https://zed.dev"
_url="https://github.com/zed-industries/${pkgname}"
license=('GPL-3.0-or-later' 'AGPL-3.0-or-later' 'Apache-2.0')
depends=(
  'alsa-lib'
  'curl'
  'fontconfig'
  'gcc-libs'
  'git'
  'glibc'
  'libx11'
  'libxcb'
  'libxkbcommon'
  'libxkbcommon-x11'
  'sqlite'
  'vulkan-driver'
  'vulkan-icd-loader'
  'wayland'
  'zstd'
)
optdepends=(
  'org.freedesktop.secrets: to keep you logged into your Zed account'
  'clang: improved C/C++ language support'
  'rust-analyzer: improved Rust language support'
)
provides=(
  "${pkgname}-bin"
  "${pkgname}-editor"
  "zeditor"
)
conflicts=(
  "${pkgname}-bin"
  "${pkgname}-editor"
)
replaces=(
  "${pkgname}-bin"
  "${pkgname}-editor"
)
options=('!strip' '!debug')
backup=("etc/${pkgname}-flags.conf")
install="${pkgname}.install"

_appid="dev.zed.Zed"

source=(
  "${pkgname}-${pkgver}.tar.gz::${_url}/releases/download/v${pkgver}/zed-linux-${CARCH}.tar.gz"
  "${pkgname}.sh"
  "${pkgname}-flags.conf"
)
sha256sums=(
  'b79a992e960ed4067cb2b50d66789ed8618eeb1780ed6a0f8f1e71dd80f74200'
  '3b77e3a9c2df8d2aecab9179c4215d6ce1f4d9060623f71a54d1933c6f359589'
  'fe562f2e57b5e8bc332bd27eb44fcdeb4dadbb756c74a456f7d2e9f6b9a0d4f5'
)

prepare() {
  cd "${srcdir}/zed.app"

  # Generate shell completions using bundled cli binary
  bin/zed --completions bash > completions.bash 2>/dev/null || true
  bin/zed --completions fish > completions.fish 2>/dev/null || true
  bin/zed --completions zsh > completions.zsh 2>/dev/null || true
}

package() {
  cd "${srcdir}/zed.app"

  # Internal binaries and resolution symlinks
  install -Dm0755 libexec/zed-editor "${pkgdir}/usr/lib/${pkgname}/zed-editor"
  ln -s zed-editor "${pkgdir}/usr/lib/${pkgname}/zed"
  install -Dm0755 bin/zed "${pkgdir}/usr/lib/${pkgname}/zed-cli"

  # Launcher wrapper & compatibility symlink
  install -Dm0755 "${srcdir}/${pkgname}.sh" "${pkgdir}/usr/bin/${pkgname}"
  ln -s "${pkgname}" "${pkgdir}/usr/bin/zeditor"

  # User flags configuration template
  install -Dm0644 "${srcdir}/${pkgname}-flags.conf" "${pkgdir}/etc/${pkgname}-flags.conf"

  # Desktop entries
  install -Dm0644 "share/applications/${_appid}.desktop" "${pkgdir}/usr/share/applications/${_appid}.desktop"
  ln -s "${_appid}.desktop" "${pkgdir}/usr/share/applications/${pkgname}.desktop"

  # Icons
  install -Dm0644 "share/icons/hicolor/512x512/apps/zed.png" "${pkgdir}/usr/share/icons/hicolor/512x512/apps/${pkgname}.png"
  install -Dm0644 "share/icons/hicolor/1024x1024/apps/zed.png" "${pkgdir}/usr/share/icons/hicolor/1024x1024/apps/${pkgname}.png"
  install -Dm0644 "share/icons/hicolor/512x512/apps/zed.png" "${pkgdir}/usr/share/pixmaps/${pkgname}.png"

  # Shell completions
  if [[ -s completions.bash ]]; then
    install -Dm0644 completions.bash "${pkgdir}/usr/share/bash-completion/completions/${pkgname}"
    ln -s "${pkgname}" "${pkgdir}/usr/share/bash-completion/completions/zeditor"
  fi

  if [[ -s completions.fish ]]; then
    install -Dm0644 completions.fish "${pkgdir}/usr/share/fish/vendor_completions.d/${pkgname}.fish"
    ln -s "${pkgname}.fish" "${pkgdir}/usr/share/fish/vendor_completions.d/zeditor.fish"
  fi

  if [[ -s completions.zsh ]]; then
    install -Dm0644 completions.zsh "${pkgdir}/usr/share/zsh/site-functions/_${pkgname}"
    ln -s "_${pkgname}" "${pkgdir}/usr/share/zsh/site-functions/_zeditor"
  fi

  # Licenses
  install -Dm0644 licenses.md "${pkgdir}/usr/share/licenses/${pkgname}/licenses.md"

  # Normalize permissions
  chmod -R u+rwX,go+rX,go-w "${pkgdir}"
}
