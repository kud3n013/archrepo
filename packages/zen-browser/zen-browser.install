_cleanup_user_desktops() {
    for user_home in /home/*; do
        if [ -d "$user_home/.local/share/applications" ]; then
            rm -f "$user_home/.local/share/applications/zen-browser.desktop" \
                  "$user_home/.local/share/applications/zen.desktop" \
                  "$user_home/.local/share/applications/zen-private.desktop" \
                  "$user_home/.local/share/applications/Zen Browser.desktop" \
                  "$user_home/.local/share/applications/Zen.desktop" 2>/dev/null || true
        fi
    done
    update-desktop-database -q 2>/dev/null || true
    gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor 2>/dev/null || true
}

post_install() {
    _cleanup_user_desktops
}

post_upgrade() {
    _cleanup_user_desktops
}

post_remove() {
    _cleanup_user_desktops
}
