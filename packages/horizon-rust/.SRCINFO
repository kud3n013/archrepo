pkgbase = horizon-rust
	pkgdesc = Launcher for Horizon, Minecraft: Java Edition rewritten in Rust
	pkgver = 0.2.81
	pkgrel = 1
	url = https://github.com/horizon-rust/horizon
	install = horizon-rust.install
	arch = x86_64
	license = LGPL-3.0-or-later
	license = MIT
	depends = glibc
	depends = hicolor-icon-theme
	depends = libglvnd
	depends = libxcb
	depends = libxkbcommon
	depends = libxkbcommon-x11
	depends = vulkan-icd-loader
	depends = wayland
	depends = alsa-lib
	depends = libx11
	depends = libxcursor
	depends = libxi
	depends = libxrandr
	depends = systemd-libs
	optdepends = vulkan-driver: GPU rendering (vulkan-radeon, vulkan-intel, nvidia-utils, ...)
	optdepends = gamemode: run the game with Feral GameMode
	optdepends = xdg-utils: open links in the default browser
	optdepends = xdg-desktop-portal: file pickers and the light/dark theme
	optdepends = base-devel: build native mods
	optdepends = libxtst: Mojang Java runtime for Java Edition instances
	provides = horizon-launcher
	conflicts = horizon-launcher
	conflicts = horizon-launcher-bin
	options = !strip
	options = !debug
	source = horizon-rust-0.2.81.tar.gz::https://github.com/horizon-rust/horizon/releases/download/launcher%400.2.81/horizon-launcher-linux-x86_64.tar.gz
