# Maintainer: kud3n013 <kud3n.013@proton.me>

pkgname=steam-globalmenu
pkgver=1.2.0
pkgrel=1
pkgdesc="High-performance, lightweight C daemon exporting Steam client menu bar to KDE Plasma Global Menu via DBusMenu"
arch=('x86_64')
url="https://github.com/kud3n013/archrepo"
license=('MIT')
depends=(
  'glib2'
  'libdbusmenu-glib'
  'libx11'
)
makedepends=(
  'gcc'
  'pkgconf'
)
optdepends=(
  'steam: Valve Steam game client'
  'millennium: Steam Client modding framework for custom CSS theme injection'
)
provides=('steam-globalmenu')
conflicts=('steam-globalmenu')
install=steam-globalmenu.install
source=(
  "steam-globalmenu.c"
  "steam-globalmenu.service"
  "quickcss.css"
)
sha256sums=('a5888e7be401fddec2b1de959f96f17dc455f62cc890632eae87d153bf551960'
            'c99b9a5d1a175055f97067d7e682a67b21b7cd4efc3df57f12b5461b353a12fc'
            'a01acf5e040fa1db83469fb67b5ce80e91d9a0edb3e79ac879b37d32439aeee7')

build() {
  cd "${srcdir}"
  gcc -O2 ${CFLAGS} ${CPPFLAGS} ${LDFLAGS} \
    steam-globalmenu.c \
    $(pkg-config --cflags --libs dbusmenu-glib-0.4 x11 gio-unix-2.0 glib-2.0) \
    -o steam-globalmenu
}

package() {
  # Compiled C daemon
  install -Dm755 "${srcdir}/steam-globalmenu" "${pkgdir}/usr/bin/steam-globalmenu"

  # Systemd user service (activates daemon silently without .desktop file clutter)
  install -Dm644 "${srcdir}/steam-globalmenu.service" "${pkgdir}/usr/lib/systemd/user/steam-globalmenu.service"

  # Documentation / Companion Quick CSS
  install -Dm644 "${srcdir}/quickcss.css" "${pkgdir}/usr/share/doc/steam-globalmenu/quickcss.css"

  # License
  install -Dm644 "${startdir}/../../LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
