# Maintainer: kud3n013 <kud3n.013@proton.me>
# Upstream: https://github.com/kud3n013/steam-dbusmenu-export

pkgname=steam-globalmenu
pkgver=1.2.0
pkgrel=3
pkgdesc="High-performance, lightweight C daemon exporting Steam client menu bar to KDE Plasma Global Menu via DBusMenu"
arch=('x86_64')
url="https://github.com/kud3n013/steam-dbusmenu-export"
license=('MIT')
depends=(
  'glib2'
  'libdbusmenu-glib'
  'libx11'
)
makedepends=(
  'gcc'
  'pkgconf'
)
optdepends=(
  'steam: Valve Steam game client'
  'millennium: Steam Client modding framework for custom CSS theme injection'
)
provides=('steam-globalmenu')
conflicts=('steam-globalmenu')
options=(!debug)
install=steam-globalmenu.install
source=("${pkgname}-${pkgver}.tar.gz::https://github.com/kud3n013/steam-dbusmenu-export/releases/download/v${pkgver}/steam-dbusmenu-export-${pkgver}.tar.gz")
sha256sums=('1b68f3f35ae6274d62d1cadf272f678c504a0c364981dc0482ed81141d2f2d06')

build() {
  cd "${srcdir}/steam-dbusmenu-export-${pkgver}"
  make
}

package() {
  cd "${srcdir}/steam-dbusmenu-export-${pkgver}"
  make DESTDIR="${pkgdir}" PREFIX=/usr install
}
